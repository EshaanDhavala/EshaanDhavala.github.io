---
/** Little index card of facts for an entry. */
interface Props { rows: [string, string][] }
const { rows } = Astro.props;
---
<dl class="specimen">
  {rows.map(([k, v]) => (<div><dt class="label">{k}</dt><dd set:html={v} /></div>))}
</dl>

<style>
  .specimen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--pencil) 55%, transparent);
    background: color-mix(in srgb, var(--paper) 70%, var(--plate));
  }
  dd { margin: 0.2rem 0 0; font-family: var(--mono); font-size: 0.95rem; }
</style>
