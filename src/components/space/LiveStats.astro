---
/**
 * "Off the clock": the personal side of the About section.
 *   Vikings: ESPN team schedule, fetched in the browser (site.web.api.espn.com allows CORS).
 *   Anime + Xbox: the live-data branch, refreshed every 3 h by .github/workflows/live-data.yml.
 *   Taco Bell: typed in by hand (no public feed).
 * Live cards stay hidden until their data arrives, so a down feed never shows a broken card.
 */
const order = [
  ['Build Your Own Cravings Box', ''],
  ['Cheesy Gordita Crunch', 'beans instead of beef'],
  ['Spicy Potato Soft Taco', ''],
  ['Cheesy Fiesta Potatoes', ''],
  ['Baja Blast Zero', ''],
];
---
<section class="otc" aria-labelledby="otc-title" data-otc>
  <h3 id="otc-title">Off the clock</h3>

  <div class="bento">
    <!-- Vikings -->
    <article class="vk tile" data-card="vikings" hidden aria-label="Minnesota Vikings">
      <div class="vk-glow" aria-hidden="true"></div>
      <p class="t-k">Minnesota Vikings <span class="live-dot" aria-hidden="true"></span></p>
      <p class="vk-rec"><span data-vk-w>0</span><i>–</i><span data-vk-l>0</span></p>
      <p class="vk-stand" data-vk-stand></p>
      <ol class="vk-games" data-vk-games aria-label="Results so far"></ol>
      <p class="t-d" data-vk-next></p>
      <p class="t-src">Live from ESPN</p>
    </article>

    <!-- Anime -->
    <article class="an tile" data-card="anime" hidden aria-label="Anime">
      <p class="t-k">Anime I’d rate 10/10</p>
      <p class="an-big"><span data-an-eps>0</span> <small>episodes watched</small></p>
      <p class="t-d" data-an-line></p>
      <ul class="shelf" data-an-shelf aria-label="Favorite anime"></ul>
      <div class="cw">
        <p class="t-k">Currently watching</p>
        <ul class="cw-list" data-an-cw></ul>
      </div>
      <p class="t-src"><a href="https://myanimelist.net/animelist/dhaesh04">My MyAnimeList</a>, <span data-an-upd>updated every few hours</span></p>
    </article>

    <!-- Taco Bell -->
    <article class="tb tile" data-card="taco" aria-label="Taco Bell">
      <p class="t-k">Taco Bell Rewards</p>
      <p class="tb-pts"><span data-countup="74518">74,518</span> <small>points</small></p>
      <div class="receipt" aria-label="My usual order">
        <p class="rc-h">The usual</p>
        <ul>
          {order.map(([item, note]) => <li><span>{item}</span>{note && <small>{note}</small>}</li>)}
        </ul>
      </div>
      <p class="t-src">As of October 2026. <a href="https://plhswave.org/4411/features/study-hard-crunch-harder/">My high school paper covered it</a></p>
    </article>

    <!-- Xbox -->
    <article class="xb tile" data-card="xbox" hidden aria-label="Xbox">
      <div class="xb-head">
        <div>
          <p class="t-k">Xbox <span class="xb-tag" data-xb-tag></span> <span class="xb-status"><i data-xb-dot></i><span data-xb-status></span></span></p>
          <p class="xb-score"><span data-xb-score>0</span> <small>gamerscore</small></p>
        </div>
        <dl class="xb-stats">
          <div><dt>Games played</dt><dd data-xb-games>–</dd></div>
          <div><dt>Achievements</dt><dd data-xb-ach>–</dd></div>
        </dl>
      </div>
      <p class="t-k">Recently played</p>
      <ul class="xb-recent" data-xb-recent></ul>
      <p class="t-k">Most played, by gamerscore earned</p>
      <ol class="xb-top" data-xb-top></ol>
      <p class="t-src">Xbox Live via OpenXBL, <span data-xb-upd>updated every few hours</span></p>
    </article>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduce } from '../../scripts/cosmos';
  const $ = (s: string, r: ParentNode = document) => r.querySelector<HTMLElement>(s);
  const set = (s: string, v: string) => { const el = $(s); if (el) el.textContent = v; };
  const getJSON = (u: string) => fetch(u).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); });
  const TZ = 'America/Los_Angeles';
  const when = (d: Date) => d.toLocaleString('en-US', { timeZone: TZ, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const ago = (iso: string) => { const h = (Date.now() - new Date(iso).getTime()) / 36e5; return h < 1 ? 'updated under an hour ago' : h < 48 ? `updated ${Math.round(h)}h ago` : `updated ${Math.round(h / 24)}d ago`; };

  // numbers count up the first time their card scrolls into view
  function countUp(el: HTMLElement, end: number) {
    if (reduce) { el.textContent = end.toLocaleString(); return; }
    const o = { v: 0 };
    el.textContent = '0';
    ScrollTrigger.create({ trigger: el, start: 'top 92%', once: true, onEnter: () => gsap.to(o, { v: end, duration: 1.6, ease: 'expo.out', onUpdate: () => (el.textContent = Math.round(o.v).toLocaleString()) }) });
  }
  function show(k: string) {
    const el = $(`[data-card="${k}"]`); if (!el) return;
    el.removeAttribute('hidden');
    ScrollTrigger.refresh();
    if (!reduce) gsap.from(el, { y: 30, opacity: 0, duration: 0.9, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 95%', once: true } });
  }
  document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => countUp(el, Number(el.dataset.countup)));

  /* ---------- Vikings ---------- */
  getJSON('https://site.web.api.espn.com/apis/site/v2/sports/football/nfl/teams/16/schedule').then((d) => {
    const games = (d.events ?? []).map((e: any) => {
      const c = e.competitions[0], us = c.competitors.find((x: any) => x.team.abbreviation === 'MIN'), them = c.competitors.find((x: any) => x.team.abbreviation !== 'MIN');
      return { date: new Date(e.date), done: c.status.type.completed, home: us.homeAway === 'home', opp: them.team.abbreviation, oppName: them.team.shortDisplayName, us: us.score?.displayValue, them: them.score?.displayValue, win: us.winner };
    });
    const done = games.filter((g: any) => g.done), next = games.find((g: any) => !g.done);
    const w = done.filter((g: any) => g.win).length;
    countUp($('[data-vk-w]')!, w); countUp($('[data-vk-l]')!, done.length - w);
    const list = $('[data-vk-games]')!;
    list.innerHTML = '';
    for (const g of done) {
      const li = document.createElement('li');
      li.className = g.win ? 'w' : 'l';
      li.title = `${g.win ? 'W' : 'L'} ${g.us}–${g.them} ${g.home ? 'vs' : 'at'} ${g.oppName}`;
      const b = document.createElement('b'), sp = document.createElement('span');
      b.textContent = g.win ? 'W' : 'L'; sp.textContent = `${g.home ? '' : '@'}${g.opp}`;
      li.append(b, sp); list.append(li);
    }
    set('[data-vk-next]', next ? `Next: ${next.home ? 'vs' : 'at'} ${next.oppName}, ${when(next.date)} PT` : 'Season over');
    show('vikings');
  }).catch(() => {});

  /* ---------- anime + Xbox (refreshed by a GitHub Action) ---------- */
  const RAW = 'https://raw.githubusercontent.com/EshaanDhavala/EshaanDhavala.github.io/live-data/';
  getJSON(RAW + 'feeds.json').then((f) => {
    const has = (n: string) => (f.available ?? []).includes(n);

    if (has('anime')) getJSON(RAW + 'anime.json').then((d) => {
      countUp($('[data-an-eps]')!, d.episodes);
      const op = (d.watching ?? []).find((x: any) => /One Piece/.test(x.title));
      set('[data-an-line]', `${d.completed} shows finished${op ? `, and on One Piece episode ${op.ep.toLocaleString()}` : ''}.`);
      set('[data-an-upd]', ago(d.updated));
      const shelf = $('[data-an-shelf]')!;
      shelf.innerHTML = '';
      (d.favorites ?? []).forEach((a: any, i: number) => {
        const li = document.createElement('li');
        li.style.setProperty('--i', String(i));
        const link = document.createElement('a'); link.href = a.url; link.target = '_blank'; link.rel = 'noopener';
        const img = document.createElement('img'); img.src = a.cover; img.alt = `${a.title} cover`; img.width = 225; img.height = 320; img.loading = 'lazy'; img.decoding = 'async';
        const t = document.createElement('span'); t.className = 'sh-t'; t.textContent = a.title;
        const sc = document.createElement('span'); sc.className = 'sh-s'; sc.textContent = `${a.score}/10`;
        link.append(img, t, sc); li.append(link); shelf.append(li);
      });
      const cw = $('[data-an-cw]')!;
      cw.innerHTML = '';
      [...(d.watching ?? [])].sort((a: any, b: any) => b.ep - a.ep).slice(0, 5).forEach((x: any) => {
        const li = document.createElement('li');
        const t = document.createElement('span'); t.className = 'cw-t'; t.textContent = x.title;
        const e = document.createElement('span'); e.className = 'cw-e'; e.textContent = x.of ? `ep ${x.ep} of ${x.of}` : `ep ${x.ep.toLocaleString()}`;
        const bar = document.createElement('i'); bar.className = 'cw-bar';
        bar.style.setProperty('--p', x.of ? String(Math.min(1, x.ep / x.of)) : '1');
        if (!x.of) bar.classList.add('ongoing');
        li.append(t, e, bar); cw.append(li);
      });
      show('anime');
    }).catch(() => {});

    if (has('vikings')) getJSON(RAW + 'vikings.json').then((d) => set('[data-vk-stand]', d.standing ?? '')).catch(() => {});

    if (has('xbox')) getJSON(RAW + 'xbox.json').then((d) => {
      if (d.gamerscore == null) return;
      set('[data-xb-tag]', d.gamertag ?? '');
      countUp($('[data-xb-score]')!, d.gamerscore);
      if (d.gamesPlayed) countUp($('[data-xb-games]')!, d.gamesPlayed);
      if (d.achievements) countUp($('[data-xb-ach]')!, d.achievements);
      $('[data-xb-dot]')!.className = d.online ? 'on' : '';
      set('[data-xb-status]', d.online ? 'online' : 'offline');
      set('[data-xb-upd]', ago(d.updated));
      const rel = (iso: string) => { const days = Math.floor((Date.now() - new Date(iso).getTime()) / 864e5); return days <= 0 ? 'today' : days === 1 ? 'yesterday' : days < 30 ? `${days} days ago` : new Date(iso).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }); };
      const recent = $('[data-xb-recent]')!; recent.innerHTML = '';
      (d.recent ?? []).forEach((g: any, i: number) => {
        const li = document.createElement('li'); li.style.setProperty('--i', String(i));
        const fig = document.createElement('div'); fig.className = 'xr-art';
        if (g.cover) { const img = document.createElement('img'); img.src = g.cover; img.alt = ''; img.width = 160; img.height = 160; img.loading = 'lazy'; img.decoding = 'async'; fig.append(img); }
        const ring = document.createElement('span'); ring.className = 'xr-pct'; ring.style.setProperty('--p', String(g.pct / 100)); ring.textContent = `${g.pct}%`; ring.title = `${g.pct}% of achievements`;
        fig.append(ring);
        const n = document.createElement('span'); n.className = 'xr-n'; n.textContent = g.name;
        const w = document.createElement('span'); w.className = 'xr-w'; w.textContent = rel(g.lastPlayed);
        li.append(fig, n, w); recent.append(li);
      });
      const top = $('[data-xb-top]')!; top.innerHTML = '';
      const max = Math.max(1, ...(d.top ?? []).map((g: any) => g.earned));
      (d.top ?? []).forEach((g: any) => {
        const li = document.createElement('li');
        const n = document.createElement('span'); n.className = 'xt-n'; n.textContent = g.name;
        const v = document.createElement('span'); v.className = 'xt-v'; v.textContent = `${g.earned.toLocaleString()} G`;
        const bar = document.createElement('i'); bar.className = 'xt-bar'; bar.style.setProperty('--p', String(g.earned / max));
        li.append(n, v, bar); top.append(li);
      });
      show('xbox');
    }).catch(() => {});
  }).catch(() => {});
</script>

<style>
  .otc { grid-column: 1 / -1; margin-top: clamp(40px, 7vh, 80px); }
  .otc h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 300; margin-bottom: 18px; }
  .bento { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) {
    .bento { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-flow: dense; }
    .an { grid-column: span 7; grid-row: span 2; }
    .vk, .tb { grid-column: span 5; }
    .xb { grid-column: span 12; }
  }
  .tile { position: relative; overflow: hidden; border-radius: 24px; padding: 22px 24px 18px; display: flex; flex-direction: column; gap: 10px; background: var(--glass); box-shadow: inset 0 0 0 1px var(--faint), inset 0 1px 0 rgba(255, 255, 255, 0.07); }
  .tile[hidden] { display: none; }
  .t-k { color: var(--ink-2); font-size: 0.84rem; display: flex; align-items: center; gap: 8px; }
  .t-d { font-size: 0.95rem; line-height: 1.45; }
  .t-src { margin-top: auto; padding-top: 4px; color: var(--ink-2); font-size: 0.74rem; opacity: 0.75; }
  .t-src a { color: inherit; text-underline-offset: 2px; }
  .tile small { font-size: 0.9rem; color: var(--ink-2); font-stretch: 100%; letter-spacing: 0; font-weight: 400; }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #ffc62f; animation: ping 2.2s ease-out infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(255, 198, 47, 0.6); } 70%, 100% { box-shadow: 0 0 0 8px rgba(255, 198, 47, 0); } }

  /* Vikings: the one tile in team colours */
  .vk { background: linear-gradient(150deg, rgba(79, 38, 131, 0.6), rgba(79, 38, 131, 0.12) 65%), var(--glass); box-shadow: inset 0 0 0 1px rgba(160, 120, 230, 0.35); }
  .vk-glow { position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 198, 47, 0.26), transparent 65%); pointer-events: none; }
  .vk-rec { display: flex; align-items: baseline; gap: 6px; font-weight: 300; font-stretch: 125%; font-size: clamp(4rem, 7vw, 5.6rem); line-height: 0.9; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .vk-rec i { font-style: normal; color: #ffc62f; }
  .vk-stand { color: #ffd76a; font-size: 0.95rem; min-height: 1.3em; }
  .vk-games { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .vk-games :global(li) { display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 44px; padding: 6px 6px 5px; border-radius: 10px; font-size: 0.72rem; color: var(--ink-2); background: rgba(0, 0, 0, 0.32); }
  .vk-games :global(b) { font-weight: 600; font-size: 0.9rem; }
  .vk-games :global(li.w b) { color: #ffc62f; }

  /* Anime: a shelf of covers */
  .an-big, .tb-pts { font-weight: 300; font-stretch: 125%; font-size: clamp(2.6rem, 4.6vw, 3.6rem); line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .shelf { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: 10px; }
  @media (max-width: 560px) { .shelf { grid-template-columns: repeat(5, 120px); overflow-x: auto; scrollbar-width: none; padding: 8px 2px 4px; } }
  .shelf :global(a) { display: flex; flex-direction: column; gap: 6px; text-decoration: none; transform: rotate(calc((var(--i) - 2) * 1.6deg)); transition: transform 500ms var(--ease); }
  .shelf :global(a:hover) { transform: rotate(0) translateY(-8px) scale(1.04); }
  .shelf :global(img) { width: 100%; height: auto; aspect-ratio: 225 / 320; object-fit: cover; border-radius: 12px; box-shadow: 0 0 0 1px var(--faint), 0 18px 40px -16px rgba(0, 0, 0, 0.9); background: #0b0c11; transition: box-shadow 400ms; }
  .shelf :global(a:hover img) { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.4), 0 0 40px rgba(140, 120, 255, 0.35); }
  :global(.sh-t) { font-size: 0.82rem; line-height: 1.25; color: var(--ink); }
  :global(.sh-s) { font-size: 0.74rem; color: var(--amber); margin-top: -4px; }

  .cw { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--faint); display: flex; flex-direction: column; gap: 10px; }
  .cw-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .cw-list :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; font-size: 0.9rem; }
  .cw-list :global(.cw-e) { color: var(--ink-2); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .cw-list :global(.cw-bar) { grid-column: 1 / -1; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.08); position: relative; overflow: hidden; }
  .cw-list :global(.cw-bar::after) { content: ''; position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(var(--p)); background: linear-gradient(90deg, #7d8fd6, #cfdcff); border-radius: inherit; }
  .cw-list :global(.cw-bar.ongoing::after) { background: linear-gradient(90deg, rgba(207, 220, 255, 0), #cfdcff 50%, rgba(207, 220, 255, 0)); animation: ongoing 2.6s linear infinite; }
  @keyframes ongoing { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

  /* Taco Bell: points + a receipt */
  .tb-pts span { background: linear-gradient(90deg, #f5f7fb, #c9b6ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .receipt { margin-top: 4px; padding: 14px 16px 24px; border-radius: 12px 12px 0 0; background: rgba(255, 255, 255, 0.05);
    -webkit-mask: radial-gradient(circle 6px at 8px 100%, transparent 98%, #000) 0 0 / 16px 100% repeat-x; mask: radial-gradient(circle 6px at 8px 100%, transparent 98%, #000) 0 0 / 16px 100% repeat-x; }
  .rc-h { font-size: 0.74rem; color: var(--ink-2); margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px dashed rgba(255, 255, 255, 0.18); }
  .receipt ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .receipt li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; font-size: 0.9rem; }
  .receipt li small { font-size: 0.78rem; color: var(--amber); }

  /* Xbox: Xbox-green accents, recently played covers, most-played bars */
  .xb { background: linear-gradient(160deg, rgba(16, 124, 16, 0.22), rgba(16, 124, 16, 0.02) 55%), var(--glass); box-shadow: inset 0 0 0 1px rgba(80, 200, 80, 0.22); gap: 14px; }
  .xb-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 14px 28px; }
  .xb-tag { color: var(--ink); font-weight: 500; }
  .xb-score { font-weight: 300; font-stretch: 125%; font-size: clamp(2.6rem, 4.6vw, 3.6rem); line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; margin-top: 6px; }
  .xb-status { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); }
  .xb-status i { width: 8px; height: 8px; border-radius: 50%; background: #5d6578; }
  .xb-status i.on { background: #4ade80; box-shadow: 0 0 10px #4ade80; }
  .xb-stats { display: flex; gap: 28px; }
  .xb-stats dt { color: var(--ink-2); font-size: 0.8rem; }
  .xb-stats dd { margin: 2px 0 0; font-weight: 300; font-stretch: 122%; font-size: 1.8rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .xb-recent { list-style: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 760px) { .xb-recent { grid-template-columns: repeat(6, 110px); overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; } }
  .xb-recent :global(li) { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .xb-recent :global(.xr-art) { position: relative; aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: #0b0c11; box-shadow: 0 0 0 1px var(--faint), 0 16px 30px -16px rgba(0, 0, 0, 0.9); transition: transform 500ms var(--ease), box-shadow 400ms; }
  .xb-recent :global(li:hover .xr-art) { transform: translateY(-6px); box-shadow: 0 0 0 1px rgba(120, 230, 120, 0.5), 0 0 30px rgba(16, 124, 16, 0.45); }
  .xb-recent :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .xb-recent :global(.xr-pct) { position: absolute; right: 6px; bottom: 6px; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; font-size: 0.64rem; font-weight: 600; color: #fff;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.82) 74%, transparent 76% 100%), conic-gradient(#4ade80 calc(var(--p) * 360deg), rgba(255, 255, 255, 0.18) 0); }
  .xb-recent :global(.xr-n) { font-size: 0.82rem; line-height: 1.25; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .xb-recent :global(.xr-w) { font-size: 0.74rem; color: var(--ink-2); margin-top: -2px; }
  .xb-top { list-style: none; display: grid; gap: 10px 28px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .xb-top :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; font-size: 0.9rem; counter-increment: xt; }
  .xb-top :global(.xt-n::before) { content: counter(xt) '  '; color: #4ade80; font-variant-numeric: tabular-nums; }
  .xb-top :global(.xt-v) { color: var(--ink-2); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .xb-top :global(.xt-bar) { grid-column: 1 / -1; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.08); position: relative; overflow: hidden; }
  .xb-top :global(.xt-bar::after) { content: ''; position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(var(--p)); background: linear-gradient(90deg, #107c10, #4ade80); border-radius: inherit; }

  @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } .shelf :global(a) { transform: none; } }
</style>
