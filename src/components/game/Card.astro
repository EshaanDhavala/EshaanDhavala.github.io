---
import type { Entry } from '../../data/entries';
import { CATS } from '../../data/entries';
import { asset } from '../../lib/asset';
interface Props { e: Entry; eager?: boolean; headingLevel?: 2 | 3; big?: boolean }
const { e, eager = false, headingLevel = 3, big = false } = Astro.props;
const H = `h${headingLevel}`;
const year = (e.when.match(/20\d\d/g) ?? ['']).slice(-1)[0];
const src = e.pic.kind === 'img' ? asset(e.pic.src) : '';
const alt = e.pic.kind === 'img' ? e.pic.alt : '';
const video = e.video ? asset(e.video.src) : undefined;
---
<article class:list={['card', { big }]} data-cats={e.cats.join(' ')} data-card style={`--c: var(--k-${e.plate})`}>
  <div class="pic" style={`view-transition-name: pic-${e.slug}`} data-hover-video={video}>
    <img src={src} alt={alt} width="1280" height="800" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <div class="body">
    <p class="stat"><b data-countup>{e.stat.value}</b> <span>{e.stat.label}</span></p>
    <H class="name"><a href={`/entries/${e.slug}/`}>{e.name}</a></H>
    <p class="what">{e.what}</p>
    <p class="meta">
      {e.cats.map((c) => <span class="cat">{CATS.find((x) => x.id === c)!.label}</span>)}
      <span class="yr">{year}</span>
    </p>
  </div>
</article>

<style>
  .card {
    container-type: inline-size;
    position: relative; display: flex; flex-direction: column; min-width: 0;
    background: var(--panel);
    border-radius: var(--r); overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 180ms ease-out;
  }
  .card:hover { box-shadow: inset 0 0 0 1px var(--ink-2); }
  .card:has(a:focus-visible) { outline: 3px solid var(--lime); outline-offset: 4px; }
  .pic { position: relative; aspect-ratio: 16 / 10; background: #000; overflow: hidden; }
  .pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1); }
  .card:hover .pic img { transform: scale(1.04); }
  .pic :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 250ms ease-out; }
  .pic :global(video.on) { opacity: 1; }
  .pic[data-hover-video]::after { content: 'Hover to play'; position: absolute; right: 8px; bottom: 8px; font: 600 0.7rem/1 var(--body); color: var(--ink); background: rgba(15, 23, 36, 0.8); padding: 5px 7px; border-radius: 4px; transition: opacity 200ms; }
  .card:hover .pic[data-hover-video]::after { opacity: 0; }
  @media (hover: none) { .pic[data-hover-video]::after { display: none; } }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px 16px; flex: 1; }
  .stat { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 8px; line-height: 1; }
  .stat b { font: 800 clamp(1.8rem, 15cqi, 2.7rem)/0.95 var(--display); color: var(--blue); letter-spacing: 0.01em; }
  .stat span { font: 600 0.78rem/1.2 var(--body); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); }
  .name { font-size: clamp(1.35rem, 9cqi, 1.7rem); line-height: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .name a { text-decoration: none; }
  .name a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .name a:focus-visible { outline: none; }
  .what { color: var(--ink-2); font-size: 0.95rem; line-height: 1.4; }
  .meta { margin-top: auto; padding-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; border-top: 1px solid var(--line); }
  .yr { margin-left: auto; font: 700 1.05rem/1 var(--display); color: var(--ink-2); }
  /* starters: wide horizontal card with larger type */
  @media (min-width: 900px) {
    :global(html:not([data-filtered])) .big { flex-direction: row; }
    :global(html:not([data-filtered])) .big .pic { flex: none; width: 56%; aspect-ratio: 16 / 10; }
    :global(html:not([data-filtered])) .big .body { padding: 22px 24px; gap: 10px; justify-content: center; }
    :global(html:not([data-filtered])) .big .stat b { font-size: clamp(2.4rem, 7cqi, 3.4rem); }
    :global(html:not([data-filtered])) .big .name { font-size: clamp(1.8rem, 4.6cqi, 2.4rem); }
    :global(html:not([data-filtered])) .big .what { font-size: 1.05rem; }
  }
  /* phones: compact side-by-side card so the whole list scans quickly */
  @media (max-width: 600px) {
    .card { flex-direction: row; align-items: stretch; }
    .pic { flex: none; width: 38%; aspect-ratio: auto; min-height: 100%; }
    .body { padding: 10px 12px 12px; gap: 5px; }
    .stat b { font-size: 1.45rem; }
    .stat span { font-size: 0.72rem; }
    .name { font-size: 1.15rem; }
    .what { font-size: 0.84rem; line-height: 1.35; }
    .meta { padding-top: 6px; gap: 4px; }
    .meta :global(.cat) { font-size: 0.7rem; padding: 4px 6px 3px; }
    .yr { font-size: 0.85rem; }
  }
</style>
