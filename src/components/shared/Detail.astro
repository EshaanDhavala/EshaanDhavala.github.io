---
/** Theme-neutral project detail: media, charts, bullets, figures, links. Themes style it via the .d-* classes. */
import type { Entry } from '../../data/entries';
import FgLive from '../FgLive.astro';
import QbReplay from '../QbReplay.astro';
import PlayScanDemo from '../demos/PlayScanDemo.astro';
import JournalDemo from '../demos/JournalDemo.astro';
import TennisDemo from '../demos/TennisDemo.astro';
import AdhdDemo from '../demos/AdhdDemo.astro';
import HouseDemo from '../demos/HouseDemo.astro';
import { asset } from '../../lib/asset';
interface Props { e: Entry; headingLevel?: 2 | 3 }
const { e, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
// One interactive demo per project, each in its own file under components/demos.
const DEMOS: Record<string, any> = {
  playscan: PlayScanDemo, 'journal-to-data': JournalDemo, 'tennis-scouting': TennisDemo,
  'adhd-diagnosis': AdhdDemo, 'house-prices': HouseDemo,
};
const Demo = DEMOS[e.slug];
const chartLabel: Record<string, string> = {
  qb: 'Clutch rating (EPA per play) by quarterback. Right of zero: better than their own average on clutch plays.',
  journal: 'Weekly averages: mood (1–10) and hours of sleep.',
  'journal-dow': 'By day of the week: average mood and how often I went to the gym.',
  tennis: 'One UCLA player’s returns in one match, where each landed. Names left off.',
};
---
<div class="detail">
  <dl class="d-meta">
    <div><dt>When</dt><dd>{e.when}</dd></div>
    <div><dt>Where</dt><dd>{e.where}</dd></div>
    <div><dt>Stack</dt><dd>{e.stack.join(' · ')}</dd></div>
  </dl>
  {e.video && (
    <figure class="d-video" id="demo">
      <video src={asset(e.video.src)} poster={asset(e.video.poster)} muted loop playsinline controls preload="none" data-autoplay aria-label={e.video.label}></video>
      {e.chapters && (
        <div class="d-chapters" role="group" aria-label="Jump to a play">
          {e.chapters.map((c) => <button type="button" data-chapter={c.t}>{c.label}</button>)}
        </div>
      )}
    </figure>
  )}
  {Demo && <Demo />}
  <div class="d-cols">
    <div>
      <H class="d-h">What I built</H>
      <ul class="d-list">{e.built.map((b) => <li>{b}</li>)}</ul>
    </div>
    {e.results.length > 0 && (
      <div>
        <H class="d-h">Results</H>
        <ul class="d-list d-results">{e.results.map((b) => <li>{b}</li>)}</ul>
      </div>
    )}
  </div>
  {e.note && <p class="d-note">{e.note}</p>}
  {e.charts?.map((c) =>
    c === 'replay' ? (
      <figure class="d-chart d-replay"><QbReplay /><figcaption>The same Herbert dropback, from the tracking data: scrub it, slow it down, or compare the pocket at the snap with the pocket at the throw.</figcaption></figure>
    ) : c === 'fg' ? (
      <figure class="d-fg"><FgLive /><figcaption>Predictions from the trained model: outdoor, 55°F, no rain, sea level, tie game. Kicker tiers are relative to league average at each distance. Gusts above 15 mph are too rare in the data to separate.</figcaption></figure>
    ) : (
      <figure class="d-chart">
        {c === 'tennis' && (
          <div class="d-filters" role="group" aria-label="Filter returns">
            <button type="button" data-tennis="all" aria-pressed="true">All returns</button>
            <button type="button" data-tennis="first_return" aria-pressed="false">vs 1st serve</button>
            <button type="button" data-tennis="second_return" aria-pressed="false">vs 2nd serve</button>
            <button type="button" data-tennis="Forehand" aria-pressed="false">Forehand</button>
            <button type="button" data-tennis="Backhand" aria-pressed="false">Backhand</button>
          </div>
        )}
        <div class="chart" data-chart={c} role="img" aria-label={chartLabel[c]}></div><figcaption>{chartLabel[c]}</figcaption>
      </figure>
    ),
  )}
  {e.figures?.map((f) => (
    <figure class="d-fig">
      <a href={asset(f.src)}><img src={asset(f.src)} alt={f.alt} width={f.w} height={f.h} loading="lazy" decoding="async" /></a>
      <figcaption>{f.caption}</figcaption>
    </figure>
  ))}
  {e.links.length > 0 && <p class="d-links">{e.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}</p>}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-chapter]').forEach((b) => b.addEventListener('click', () => {
    const v = b.closest('figure')!.querySelector('video')!;
    v.currentTime = +b.dataset.chapter! + 0.05; v.play().catch(() => {});
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-tennis]').forEach((b) => b.addEventListener('click', () => {
    b.parentElement!.querySelectorAll('[data-tennis]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    (window as any).__tennisFilter = b.dataset.tennis;
    window.dispatchEvent(new Event('resize'));
  }));
</script>
