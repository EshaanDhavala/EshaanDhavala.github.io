---
/** Small stroke icon set, 24px grid, 2px stroke. */
interface Props { name: 'bag' | 'plus' | 'check' | 'arrow-left' | 'arrow-right' | 'x' | 'external' | 'copy' | 'mail' | 'file' | 'moon'; size?: number }
const { name, size = 20 } = Astro.props;
const paths: Record<Props['name'], string> = {
  bag: 'M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z M9 8V6.5a3 3 0 0 1 6 0V8',
  plus: 'M12 5v14 M5 12h14',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  'arrow-left': 'M19 12H5 M11 6l-6 6 6 6',
  'arrow-right': 'M5 12h14 M13 6l6 6-6 6',
  x: 'M6 6l12 12 M18 6L6 18',
  external: 'M14 5h5v5 M19 5l-8 8 M17 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h4',
  copy: 'M9 9h10v10H9z M5 15V5h10',
  mail: 'M4 6h16v12H4z M4 7l8 6 8-6',
  file: 'M7 3h7l4 4v14H7z M14 3v4h4 M10 12h5 M10 16h5',
  moon: 'M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {paths[name].split(' M').map((d, i) => <path d={i ? 'M' + d : d} />)}
</svg>
