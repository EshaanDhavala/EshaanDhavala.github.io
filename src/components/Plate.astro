---
/** A figure "pasted" into the notebook. */
interface Props { src?: string; alt?: string; fig: number | string; wide?: boolean; tilt?: number }
const { src, alt = '', fig, wide = false, tilt = 0 } = Astro.props;
---
<figure class:list={['plate', 'taped', { wide }]} style={`--tilt:${tilt}deg`}>
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <slot name="media" />}
  <figcaption><span class="mono">Fig. {fig}</span> — <slot /></figcaption>
</figure>

<style>
  .plate {
    margin: 2.5rem 0;
    background: var(--plate);
    padding: 0.75rem 0.75rem 0.6rem;
    box-shadow: var(--shadow);
    transform: rotate(var(--tilt));
  }
  .plate :global(img), .plate :global(video) { width: 100%; }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  figcaption .mono { font-style: normal; color: var(--pencil); }
  @media (min-width: 1080px) {
    .wide { margin-right: calc(-1 * var(--margin-col) - 3rem); }
  }
</style>
