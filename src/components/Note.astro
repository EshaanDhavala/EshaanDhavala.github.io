---
/** A handwritten margin note. Floats into the right margin on wide screens, sits inline on phones. */
interface Props { arrow?: boolean; tilt?: number }
const { arrow = true, tilt = -1.5 } = Astro.props;
---
<aside class="note" style={`--tilt:${tilt}deg`}>
  {arrow && (
    <svg class="arrow" viewBox="0 0 60 28" aria-hidden="true">
      <path d="M58 6 C 40 2, 22 6, 6 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M6 20 l 9 -1.5 M6 20 l 2.5 -8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )}
  <slot />
</aside>

<style>
  .note {
    font-family: var(--hand);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--pen);
    transform: rotate(var(--tilt));
    margin: 0.5rem 0 1.25rem;
    padding-left: 0.75rem;
    border-left: 2px solid color-mix(in srgb, var(--pen) 35%, transparent);
  }
  .arrow { display: none; width: 52px; height: 24px; color: var(--pen); }
  @media (min-width: 1080px) {
    .note {
      float: right;
      clear: right;
      width: var(--margin-col);
      margin-right: calc(-1 * var(--margin-col) - 3rem);
      margin-top: 0.2rem;
      padding-left: 0;
      border-left: 0;
    }
    .arrow { display: block; margin-left: -0.5rem; margin-bottom: -0.25rem; }
  }
</style>
