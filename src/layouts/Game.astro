---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800-italic.css';
import '@fontsource/barlow-condensed/900-italic.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '../styles/game.css';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = 'Eshaan Dhavala: Stats & Data Science at UCLA. Sports models, ML tools, and AI assistants.',
  image = '/img/eshaan-circle.jpg',
} = Astro.props;
const fullTitle = title ? `${title} · Eshaan Dhavala` : 'Eshaan Dhavala';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#06080e" />
  </head>
  <body>
    <a class="visually-hidden skip" href="#main">Skip to content</a>
    <header class="hud">
      <a class="brand" href="/" aria-label="Eshaan Dhavala, home"><span>Eshaan</span> <span>Dhavala</span></a>
      <nav aria-label="Site">
        <a href="/#projects">Projects</a>
        <a href="/#profile">Profile</a>
        <a href="/resume.pdf">Résumé</a>
        <a class="mail" href="mailto:eshaandhavala@gmail.com">Email</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot wrap">
      <span class="fname">Eshaan Dhavala</span>
      <a href="mailto:eshaandhavala@gmail.com">eshaandhavala@gmail.com</a>
      <a href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
      <a href="https://github.com/EshaanDhavala">GitHub</a>
      <a href="/resume.pdf">Résumé</a>
    </footer>
    <script>
      import '../scripts/game-motion';
      import '../scripts/media';
      import '../scripts/charts';
    </script>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 10px; left: 10px; width: auto; height: auto; clip: auto; z-index: 60; background: var(--lime); color: var(--on-lime); padding: 10px 14px; border-radius: 8px; }
  .hud {
    position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    height: 64px; padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.28em; min-height: 44px; text-decoration: none; font: italic 900 1.45rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.01em; white-space: nowrap; }
  .brand span:last-child { color: var(--lime); }
  nav { display: flex; align-items: center; gap: clamp(0.75rem, 2.4vw, 1.75rem); font: italic 800 1.05rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.05em; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--ink-2); }
  nav a:hover { color: var(--ink); }
  nav .mail { color: var(--on-lime); background: var(--lime); padding: 0 14px; border-radius: 8px; }
  nav .mail:hover { background: #d4ff6a; color: var(--on-lime); }
  @media (max-width: 560px) {
    .hud { height: 58px; }
    .brand { font-size: 1.2rem; }
    nav { gap: 0.8rem; font-size: 0.95rem; }
    nav a[href='/resume.pdf'] { display: none; }
    nav .mail { padding: 0 12px; }
  }
  .foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.6rem; padding: 3rem 0 4rem; margin-top: 5rem; border-top: 1px solid var(--line); color: var(--ink-2); font-size: 0.95rem; }
  .foot .fname { font: italic 800 1.15rem/1 var(--display); text-transform: uppercase; color: var(--ink); }
  .foot a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .foot a:hover { color: var(--lime); }
</style>
