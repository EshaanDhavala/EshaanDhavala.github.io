---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '../styles/game.css';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = 'Eshaan Dhavala: Stats & Data Science at UCLA. Sports models, ML tools, and AI assistants.',
  image = '/img/eshaan-circle.jpg',
} = Astro.props;
const fullTitle = title ? `${title} · Eshaan Dhavala` : 'Eshaan Dhavala';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#06080e" />
  </head>
  <body>
    <a class="visually-hidden skip" href="#main">Skip to content</a>
    <header class="hud">
      <a class="brand" href="/" aria-label="Eshaan Dhavala, home"><span>Eshaan</span> <span>Dhavala</span></a>
      <nav aria-label="Site">
        <a href="/#projects">Projects</a>
        <a href="/#profile">About</a>
        <a href="/resume.pdf">Résumé</a>
        <a class="mail" href="mailto:eshaandhavala@gmail.com">Email</a>
      </nav>
    </header>
    <div class="yard-progress" aria-hidden="true"><i data-yard-fill></i></div>
    <main id="main">
      <slot />
    </main>
    <footer class="foot wrap">
      <span class="fname">Eshaan Dhavala</span>
      <a href="mailto:eshaandhavala@gmail.com">eshaandhavala@gmail.com</a>
      <a href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
      <a href="https://github.com/EshaanDhavala">GitHub</a>
      <a href="/resume.pdf">Résumé</a>
      <details class="what-moves">
        <summary>What’s moving in the background?</summary>
        <p>Every animation on this site is drawn from real data from my projects:</p>
        <ul>
          <li><b>Top of the page:</b> a real NFL dropback replayed from 10 Hz player-tracking data (Justin Herbert, 2021 Week 3 at Kansas City). Blue dots are the offense, gray the defense, the outline is the pocket forming and collapsing. From QB Clutch Ratings.</li>
          <li><b>Next to “Projects”:</b> the clutch ratings of all 15 quarterbacks, sorted. Bars above the line beat their own average in close games.</li>
          <li><b>Under the field-goal model:</b> make probability by kick distance for an average kicker (blue), with elite and struggling kickers (gray). The gold dot rides the curve.</li>
          <li><b>Beside “About me” (wide screens):</b> where one UCLA tennis player’s returns landed in a match, appearing one at a time. Gold marks returns that missed.</li>
          <li><b>By “About me”:</b> my weekly average mood from 131 days of journal entries (JournalToData).</li>
          <li><b>Above the field-goal model:</b> the USAA closure-reason capture rate climbing from 28% to 66%.</li>
          <li><b>Next to the field-goal title:</b> PlayScan’s pass / run / special-teams probabilities on the 6 plays in its demo video.</li>
          <li><b>Next to “More projects”:</b> the UCLA Football AI assistant: a question, typing dots, then the answer’s bars (synthetic demo data).</li>
          <li><b>In “About me”:</b> share of severe (blue), moderate and mild ADHD cases by household income, from the DataLearn project.</li>
          <li><b>The bar under the top menu:</b> how far down the page you are, marked every 10 like yard lines.</li>
        </ul>
        <p>Each one draws in, holds, fades out, and loops. They stop when you scroll away and stay still if your device asks for reduced motion.</p>
      </details>
    </footer>
    <script>
      import '../scripts/game-motion';
      import '../scripts/media';
      import '../scripts/charts';
    </script>
  </body>
</html>

<style>
  .yard-progress { position: fixed; left: 0; right: 0; top: 64px; height: 4px; z-index: 39; pointer-events: none;
    background: repeating-linear-gradient(90deg, transparent 0 calc(10% - 1px), rgba(169, 180, 198, 0.35) calc(10% - 1px) 10%); }
  .yard-progress i { display: block; height: 100%; width: 100%; background: var(--blue); transform: scaleX(var(--p, 0)); transform-origin: 0 50%; }
  @media (max-width: 560px) { .yard-progress { top: 58px; } }
  .skip:focus { position: fixed; top: 10px; left: 10px; width: auto; height: auto; clip: auto; z-index: 60; background: var(--lime); color: var(--on-lime); padding: 10px 14px; border-radius: 8px; }
  .hud {
    position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    height: 64px; padding: 0 var(--gutter);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.28em; min-height: 44px; text-decoration: none; font: 900 1.55rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.01em; white-space: nowrap; }
  .brand span:last-child { color: var(--blue); }
  nav { display: flex; align-items: center; gap: clamp(0.75rem, 2.4vw, 1.75rem); font: 800 1.1rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.06em; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--ink-2); }
  nav a:hover { color: var(--ink); }
  nav .mail { color: var(--on-lime); background: var(--lime); padding: 0 14px; border-radius: 8px; }
  nav .mail:hover { background: #f7c25e; color: var(--on-lime); }
  @media (max-width: 560px) {
    .hud { height: 58px; }
    .brand { font-size: 1.2rem; }
    nav { gap: 0.8rem; font-size: 0.95rem; }
    nav a[href='/resume.pdf'] { display: none; }
    nav .mail { padding: 0 12px; }
  }
  .foot { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 1.6rem; padding: 3rem 0 4rem; margin-top: 5rem; border-top: 1px solid var(--line); color: var(--ink-2); font-size: 0.95rem; }
  .foot .fname { display: inline-flex; align-items: center; min-height: 44px; font: 800 1.2rem/1 var(--display); text-transform: uppercase; color: var(--ink); }
  .foot a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .foot a:hover { color: var(--lime); }
  .what-moves { flex-basis: 100%; max-width: 46rem; margin: 1rem auto 0; font-size: 0.9rem; color: var(--ink-2); text-align: left; }
  .what-moves summary { cursor: pointer; text-align: center; color: var(--ink-2); min-height: 44px; display: flex; align-items: center; justify-content: center; }
  .what-moves summary:hover { color: var(--ink); }
  .what-moves ul { margin: 0.6rem 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .what-moves b { color: var(--ink); font-weight: 600; }
</style>
