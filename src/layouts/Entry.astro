---
import Notebook from './Notebook.astro';
import { entries, bySlug } from '../data/entries';

interface Props {
  slug: string;
  links?: { href: string; label: string }[];
  image?: string;
}
const { slug, links = [], image } = Astro.props;
const e = bySlug(slug);
const i = entries.indexOf(e);
const prev = entries[i - 1];
const next = entries[i + 1];
const no = String(e.no).padStart(2, '0');
---
<Notebook title={e.title} description={e.blurb} image={image}>
  <article class="entry">
    <header class="head ink-in">
      <p class="label">Entry No. {no} · {e.when} · {e.context}</p>
      <h1>{e.title}</h1>
      <p class="lede">{e.blurb}</p>
      <p class="meta">
        <span class="hook"><mark>{e.hook}</mark></span>
        {e.tags.map((t) => <span class="tag">{t}</span>)}
      </p>
      <p class="stack mono">{e.stack.join(' · ')}</p>
      {links.length > 0 && (
        <p class="links">
          {links.map((l) => <a href={l.href} rel="noopener">{l.label} ↗</a>)}
        </p>
      )}
    </header>

    <div class="body">
      <slot />
    </div>

    <nav class="turn" aria-label="More entries">
      {prev ? <a href={`/entries/${prev.slug}/`}><span class="label">← No. {String(prev.no).padStart(2, '0')}</span>{prev.title}</a> : <span />}
      {next ? <a class="next" href={`/entries/${next.slug}/`}><span class="label">No. {String(next.no).padStart(2, '0')} →</span>{next.title}</a> : <span />}
    </nav>
  </article>
</Notebook>

<style>
  .entry { max-width: var(--measure); padding-top: 2.5rem; }
  @media (min-width: 1080px) {
    .entry { margin-left: 4rem; }
  }
  h1 { font-size: clamp(2.1rem, 5vw, 3.3rem); margin: 0.6rem 0 1rem; }
  .lede { font-size: 1.22rem; color: var(--ink-soft); line-height: 1.5; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: baseline; margin: 1.2rem 0 0.4rem; }
  .hook { font-family: var(--mono); font-size: 1rem; }
  .tag {
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--pencil); border: 1px solid currentColor; border-radius: 2px; padding: 0.05rem 0.4rem;
  }
  .stack { color: var(--pencil); margin: 0.2rem 0 0.8rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font-family: var(--mono); font-size: 0.88rem; }

  .body { margin-top: 2.5rem; }
  .body :global(h2) { margin: 3rem 0 1rem; }
  .body :global(h2 .label) { display: block; margin-bottom: 0.35rem; }
  .body :global(ul) { padding-left: 1.2rem; }
  .body :global(li) { margin-bottom: 0.45rem; }
  .body :global(li::marker) { color: var(--pencil); }
  .body :global(table) { border-collapse: collapse; width: 100%; font-size: 0.95rem; margin: 1.5rem 0; }
  .body :global(th), .body :global(td) { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px dashed color-mix(in srgb, var(--pencil) 60%, transparent); }
  .body :global(th) { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--pencil); font-weight: 400; }
  .body :global(td.num) { font-family: var(--mono); text-align: right; }
  .body :global(blockquote) {
    margin: 2rem 0; padding: 0 0 0 1.25rem; border-left: 3px solid var(--pen);
    font-family: var(--serif-display); font-style: italic; font-size: 1.3rem; line-height: 1.4;
  }

  .turn {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
    margin-top: 5rem; padding-top: 1.5rem; border-top: 1px dashed var(--pencil);
  }
  .turn a { color: var(--ink); text-decoration: none; font-family: var(--serif-display); font-size: 1.05rem; line-height: 1.3; }
  .turn a:hover { color: var(--pen); }
  .turn .label { display: block; margin-bottom: 0.3rem; }
  .turn .next { text-align: right; }
</style>
