---
/** Site shell for the space theme: sky canvas, nav, ⌘K palette, footer. */
import '@fontsource-variable/archivo/standard.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import '../styles/space.css';
import { asset } from '../lib/asset';
import { entries } from '../data/entries';

interface Props { title?: string; description?: string; image?: string; nav?: 'home' | 'tools' | 'entry' }
const {
  title,
  description = 'Eshaan Dhavala: Stats & Data Science at UCLA. ML models, LLM tools, and sports analytics.',
  image = asset('/og-space.png'),
  nav = 'home',
} = Astro.props;
const fullTitle = title ? `${title} · Eshaan Dhavala` : 'Eshaan Dhavala';
const path = Astro.url.pathname;
// the condensed cut of Archivo stands in for the old display face inside the project demos
const condFace = `@font-face{font-family:'Archivo Cond';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:72%;src:url(${archivoUrl}) format('woff2-variations');}`;
const palData = JSON.stringify({ projects: entries.map((e) => ({ slug: e.slug, name: e.name })) });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={asset('/e-star.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('/e-star-32.png')} />
    <link rel="shortcut icon" href={asset('/favicon.ico')} />
    <link rel="apple-touch-icon" href={asset('/e-star-180.png')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#000000" />
    <style is:inline set:html={condFace}></style>
    <script is:inline>if (location.pathname === '/' && !location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('intro');</script>
    <script is:inline data-goatcounter="https://eshaandhavala.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <canvas class="cosmos" data-cosmos aria-hidden="true"></canvas>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="glow" x="-400%" y="-400%" width="900%" height="900%">
          <feGaussianBlur stdDeviation="3.2" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
    </svg>

    <header class="nav">
      <a class="nav-name" href="/#top">Eshaan Dhavala</a>
      <nav aria-label="Site">
        <a href="/#projects">Projects</a>
        <a href="/#about">About</a>
        <a href="/tools/" aria-current={nav === 'tools' ? 'page' : undefined}>Tools</a>
        <a href="/resume.pdf">Résumé</a>
        <a class="nav-mail" href="mailto:eshaandhavala@gmail.com">Email</a>
        <button type="button" class="nav-k" data-pal-open aria-label="Open quick navigation (Command K)"><kbd>⌘K</kbd></button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <slot name="footer">
      <footer class="foot wrap">
        <span class="fname">Eshaan Dhavala</span>
        <a href="mailto:eshaandhavala@gmail.com">eshaandhavala@gmail.com</a>
        <a href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
        <a href="https://github.com/EshaanDhavala">GitHub</a>
        <a href="/resume.pdf">Résumé</a>
      </footer>
    </slot>

    <dialog class="palette" data-palette aria-label="Quick navigation">
      <input type="text" data-pal-input placeholder="Jump to a project, copy my email, open my résumé…" aria-label="Search" autocomplete="off" />
      <ul data-pal-list role="listbox" aria-label="Results"></ul>
      <p class="pal-hint"><kbd>↑</kbd><kbd>↓</kbd> to move, <kbd>Enter</kbd> to go, <kbd>Esc</kbd> to close</p>
    </dialog>
    <p class="toast" data-toast role="status" aria-live="polite"></p>
    <script type="application/json" id="pal-data" set:html={palData}></script>

    <script>
      import '../scripts/cosmos';
      import '../scripts/media';
      import '../scripts/charts';
    </script>
  </body>
</html>

<style>
  .foot { position: relative; z-index: 1; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 1.6rem; padding: 3rem var(--gutter) 4rem; border-top: 1px solid var(--faint); color: var(--ink-2); font-size: 0.95rem; }
  .foot .fname { color: var(--ink); font-stretch: 125%; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }
  .foot a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .foot a:hover { color: var(--ink); }
</style>
