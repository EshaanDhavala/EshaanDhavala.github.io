---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/kiosk.css';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = 'Eshaan Dhavala: Stats & Data Science at UCLA. Sports analytics, ML models, and AI tools.',
  image = '/img/eshaan.jpg',
} = Astro.props;
const fullTitle = title ? `${title} · Eshaan Dhavala` : 'Eshaan Dhavala';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#0e0d12" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="visually-hidden skip" href="#main">Skip to menu</a>
    <header class="bezel" transition:persist>
      <a class="brand" href="/" aria-label="Eshaan Dhavala, home">
        <span class="brand-name">Eshaan Dhavala</span>
        <span class="brand-sub">Stats &amp; Data Science · UCLA</span>
      </a>
      <nav class="bezel-nav" aria-label="Site">
        <a href="/#about">About</a>
        <a href="/resume.pdf">Résumé</a>
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode"><Icon name="moon" /></button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <span>Eshaan Dhavala</span>
      <a href="mailto:eshaandhavala@gmail.com">eshaandhavala@gmail.com</a>
      <a href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
      <a href="https://github.com/EshaanDhavala">GitHub</a>
      <a href="/resume.pdf">Résumé</a>
    </footer>

    <script>
      import '../scripts/media';
      document.addEventListener('astro:page-load', () => {
        const t = document.querySelector<HTMLElement>('[data-theme-toggle]');
        if (!t || t.dataset.bound) return;
        t.dataset.bound = '1';
        t.addEventListener('click', () => {
          const r = document.documentElement;
          const dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          r.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
          window.dispatchEvent(new Event('themechange'));
        });
      });
    </script>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; z-index: 50; background: var(--sauce); color: var(--sauce-ink); padding: 0.5rem 0.9rem; border-radius: 999px; }
  .bezel {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    height: 68px; padding: 0 clamp(16px, 3vw, 28px);
    background: var(--bezel); color: var(--bezel-ink);
  }
  .brand { display: flex; flex-direction: column; text-decoration: none; line-height: 1.1; }
  .brand-name { font-weight: 800; font-stretch: 125%; font-size: 1.2rem; letter-spacing: -0.01em; }
  .brand-sub { font-size: 0.78rem; color: #b9b5c8; font-weight: 500; }
  .bezel-nav { display: flex; align-items: center; gap: clamp(0.5rem, 2vw, 1.25rem); font-weight: 600; font-size: 0.95rem; }
  .bezel-nav > a { text-decoration: none; color: #d9d6e4; }
  .bezel-nav > a:hover { color: #fff; }
  .icon-btn { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; border: 0; background: transparent; cursor: pointer; color: inherit; }
  .icon-btn:hover { background: color-mix(in srgb, currentColor 12%, transparent); }
  @media (max-width: 560px) { .hide-sm { display: none; } .bag { padding: 0 0.8rem; } .brand-sub { display: none; } .brand-name { font-size: 1.02rem; font-stretch: 112%; white-space: nowrap; } .bezel-nav { gap: 0.6rem; font-size: 0.9rem; } .icon-btn { width: 36px; } }

  .foot {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; justify-content: center;
    padding: 3rem 16px 7rem; color: var(--ink-2); font-size: 0.9rem; border-top: 1px solid var(--line); margin-top: 4rem;
  }
  .foot span { font-weight: 800; color: var(--ink); }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--violet); text-decoration: underline; }

</style>
