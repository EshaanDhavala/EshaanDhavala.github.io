---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800-italic.css';
import '@fontsource/barlow-condensed/900-italic.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import Bare from '../../layouts/Bare.astro';
import Pic from '../../components/shared/Pic.astro';
import Detail from '../../components/shared/Detail.astro';
import { entries, CATS } from '../../data/entries';

const team = (where: string) =>
  where.startsWith('Bruin') ? 'BSA' : where.startsWith('USAA') ? 'USAA' : where.startsWith('UCLA') ? 'UCLA' : where.startsWith('DataLearn') ? 'DATALEARN' : 'SOLO';
const year = (when: string) => (when.match(/20\d\d/g) ?? ['']).slice(-1)[0];
const catLabel = (c: string) => CATS.find((x) => x.id === c)!.label;
const career = [
  ['2026', 'USAA', 'Data Science Intern'],
  ['2026–', 'Bruin Sports Analytics', 'Football Co-Chair'],
  ['2025–26', 'Bruin Sports Analytics', 'Tennis Analyst'],
  ['2024–26', 'Mystic Lake Steakhouse', 'Lead Host'],
];
const traits = ['Football', 'UFC', 'Weightlifting', 'Music theory', 'Co-op puzzle games', 'Japanese art history', 'Astronomy'];
---
<Bare title="Eshaan Dhavala · Sports game preview" theme="game" bg="#06080e">
  <div class="g">
    <header class="hud">
      <div class="who">
        <span class="nm">Eshaan Dhavala</span>
        <span class="sub">Stats &amp; Data Science · UCLA ’27</span>
      </div>
      <nav class="tabs" aria-label="Categories">
        <kbd aria-hidden="true">Q</kbd>
        <button type="button" data-cat="all" aria-pressed="true">All</button>
        {CATS.map((c) => <button type="button" data-cat={c.id} aria-pressed="false">{c.label}</button>)}
        <kbd aria-hidden="true">E</kbd>
      </nav>
      <div class="right">
        <a href="#profile">Profile</a>
        <a href="/resume.pdf">Résumé</a>
      </div>
    </header>

    <main class="squad">
      <section class="deck" aria-label="Projects">
        <h1 class="title">Select a project</h1>
        <div class="cards" role="listbox" aria-label="Projects" tabindex="0">
          {entries.map((e, i) => (
            <button type="button" class="card" role="option" aria-selected={i === 0 ? 'true' : 'false'} data-slug={e.slug} data-cats={e.cats.join(' ')} style={`--c: var(--k-${e.plate})`}>
              <span class="shine" aria-hidden="true"></span>
              <span class="top">
                <span class="rating"><b>{e.stat.value}</b><small>{e.stat.label}</small></span>
                <span class="tag">{catLabel(e.plate)}</span>
              </span>
              <Pic e={e} eager={i < 4} class="cpic" />
              <span class="cname">{e.name}</span>
              <span class="facts">
                <span><b>{year(e.when)}</b><small>Year</small></span>
                <span><b>{team(e.where)}</b><small>Team</small></span>
                <span><b>{e.stack[0].split(' ')[0]}</b><small>Main tool</small></span>
              </span>
            </button>
          ))}
        </div>
        <p class="hints" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> Browse <kbd>Q</kbd><kbd>E</kbd> Category <kbd>Enter</kbd> Details</p>
      </section>

      <section class="bio" aria-live="polite">
        {entries.map((e, i) => (
          <article class="panel" data-panel={e.slug} hidden={i !== 0} style={`--c: var(--k-${e.plate})`}>
            <p class="pcat">{e.cats.map(catLabel).join(' · ')}</p>
            <h2>{e.name}</h2>
            <p class="what">{e.what}</p>
            <p class="big"><b>{e.stat.value}</b> {e.stat.label}</p>
            <Detail e={e} />
          </article>
        ))}
      </section>
    </main>

    <section id="profile" class="profile" aria-labelledby="profile-h">
      <img src="/img/eshaan-45.jpg" alt="Eshaan Dhavala" width="800" height="1000" loading="lazy" />
      <div class="pinfo">
        <h2 id="profile-h">Player profile</h2>
        <ul class="pfacts">
          <li><small>Position</small><b>Stats &amp; Data Science, UCLA</b></li>
          <li><small>Class</small><b>Dec 2027</b></li>
          <li><small>Current team</small><b>Bruin Sports Analytics (Co-Chair)</b></li>
          <li><small>Looking for</small><b>2027 roles: data science, ML, sports analytics</b></li>
        </ul>
        <h3>Career</h3>
        <table class="career">
          <tbody>{career.map(([y, t, r]) => <tr><td>{y}</td><td>{t}</td><td>{r}</td></tr>)}</tbody>
        </table>
        <h3>In the news</h3>
        <a class="news" href="https://plhswave.org/4411/features/study-hard-crunch-harder/">
          <b>“Study hard, crunch harder”</b>
          <span>The Wave (Prior Lake HS) ran a feature on me and my Taco Bell order, Apr 2024.</span>
        </a>
        <h3>Traits</h3>
        <ul class="traits">{traits.map((t) => <li>{t}</li>)}</ul>
        <p class="contact">
          <a href="mailto:eshaandhavala@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
          <a href="https://github.com/EshaanDhavala">GitHub</a>
          <a href="/resume.pdf">Résumé</a>
        </p>
      </div>
    </section>
  </div>
</Bare>

<script>
  const cards = [...document.querySelectorAll<HTMLButtonElement>('.card')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [data-cat]')];
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  let cat = 'all';

  const visible = () => cards.filter((c) => !c.hidden);
  function select(card: HTMLButtonElement, focus = false, reveal = false) {
    cards.forEach((c) => c.setAttribute('aria-selected', String(c === card)));
    panels.forEach((p) => (p.hidden = p.dataset.panel !== card.dataset.slug));
    card.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
    if (focus) card.focus({ preventScroll: true });
    if (reveal && matchMedia('(max-width: 999px)').matches) document.querySelector('.bio')!.scrollIntoView({ behavior: 'smooth' });
    window.dispatchEvent(new Event('resize'));
  }
  function setCat(c: string) {
    cat = c;
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.cat === c)));
    cards.forEach((k) => (k.hidden = c !== 'all' && !k.dataset.cats!.split(' ').includes(c)));
    const sel = cards.find((k) => k.getAttribute('aria-selected') === 'true' && !k.hidden) ?? visible()[0];
    if (sel) select(sel);
  }
  cards.forEach((c) => c.addEventListener('click', () => select(c, false, true)));
  tabs.forEach((t) => t.addEventListener('click', () => setCat(t.dataset.cat!)));
  document.addEventListener('keydown', (ev) => {
    if (ev.target instanceof HTMLInputElement) return;
    const v = visible();
    const i = v.findIndex((c) => c.getAttribute('aria-selected') === 'true');
    if (ev.key === 'ArrowRight' && document.activeElement?.closest('.cards')) { ev.preventDefault(); select(v[Math.min(i + 1, v.length - 1)], true); }
    if (ev.key === 'ArrowLeft' && document.activeElement?.closest('.cards')) { ev.preventDefault(); select(v[Math.max(i - 1, 0)], true); }
    if (ev.key === 'q' || ev.key === 'e') {
      const j = tabs.findIndex((t) => t.dataset.cat === cat);
      setCat(tabs[(j + (ev.key === 'e' ? 1 : tabs.length - 1)) % tabs.length].dataset.cat!);
    }
  });
  // tilt + shine follow the pointer
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer: fine)').matches) {
    cards.forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        c.style.setProperty('--rx', `${-y * 8}deg`); c.style.setProperty('--ry', `${x * 10}deg`); c.style.setProperty('--sx', `${(x + 0.5) * 100}%`);
      });
      c.addEventListener('pointerleave', () => { c.style.removeProperty('--rx'); c.style.removeProperty('--ry'); });
    });
  }
</script>

<style>
  :global(html[data-preview='game']) {
    --bg: #06080e; --panel: #0e1320; --panel-2: #151c2e; --line: rgba(255, 255, 255, 0.09);
    --ink: #eef2ff; --ink-2: #9aa4bd; --violet: #c6ff3d; --sauce: #ff7a59;
    --k-football: #e8c25a; --k-tennis: #3dd9ff; --k-ai: #a78bfa; --k-stats: #ff7a59;
    background: var(--bg); color: var(--ink); color-scheme: dark;
  }
  :global(html[data-preview='game'] body) { margin: 0; font-family: 'Barlow', system-ui, sans-serif; background:
      radial-gradient(1200px 500px at 70% -10%, rgba(198, 255, 61, 0.08), transparent 60%),
      radial-gradient(900px 600px at 10% 110%, rgba(61, 217, 255, 0.06), transparent 60%), var(--bg); }
  :global(html[data-preview='game'] ::selection) { background: var(--violet); color: #06080e; }
  .g { min-height: 100dvh; }
  h1, h2, h3, .nm, .cname, .rating b, .big b, .tabs button { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; }

  .hud { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: 12px clamp(16px, 3vw, 32px); background: rgba(6, 8, 14, 0.82); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .who { display: flex; flex-direction: column; line-height: 1.05; }
  .nm { font-weight: 900; font-style: italic; font-size: 1.5rem; letter-spacing: 0.01em; }
  .sub { font-size: 0.8rem; color: var(--ink-2); }
  .tabs { display: flex; align-items: center; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  .tabs button { font-weight: 800; font-style: italic; font-size: 1.05rem; letter-spacing: 0.04em; color: var(--ink-2); background: none; border: 0; padding: 10px 14px; cursor: pointer; border-bottom: 3px solid transparent; white-space: nowrap; }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--violet); }
  kbd { display: inline-grid; place-items: center; min-width: 26px; height: 24px; padding: 0 6px; border-radius: 6px; font: 700 0.75rem system-ui, sans-serif; color: var(--ink); background: var(--panel-2); border: 1px solid var(--line); border-bottom-width: 3px; }
  .right { justify-self: end; display: flex; gap: 1rem; font-weight: 600; }
  .right a { color: var(--ink-2); text-decoration: none; }
  .right a:hover { color: var(--violet); }
  @media (max-width: 999px) { .hud { grid-template-columns: 1fr auto; } .tabs { grid-column: 1 / -1; grid-row: 2; } .tabs kbd { display: none; } }

  .squad { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; }
  @media (min-width: 1000px) { .squad { grid-template-columns: minmax(0, 1.25fr) minmax(380px, 1fr); height: calc(100dvh - 69px); } }
  .deck { padding: clamp(16px, 3vw, 32px); display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .title { font-weight: 900; font-style: italic; font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: 0.01em; margin: 0; }
  .cards { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(210px, 230px); gap: 18px; overflow-x: auto; padding: 18px 6px 26px; scroll-snap-type: x mandatory; scrollbar-width: thin; perspective: 900px; outline: none; }
  @media (min-width: 1000px) { .cards { grid-auto-flow: row; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); grid-auto-columns: unset; overflow-y: auto; overflow-x: hidden; scroll-snap-type: none; align-content: start; } }
  .card {
    position: relative; scroll-snap-align: center; text-align: left; cursor: pointer; color: var(--ink);
    display: flex; flex-direction: column; gap: 8px; padding: 12px; border: 0; border-radius: 16px;
    background: linear-gradient(170deg, color-mix(in srgb, var(--c) 26%, var(--panel-2)) 0%, var(--panel) 55%);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 35%, transparent), 0 10px 26px -18px #000;
    transform: rotateX(var(--rx, 0)) rotateY(var(--ry, 0));
    transition: transform 180ms ease-out, box-shadow 180ms ease-out, opacity 180ms ease-out;
    overflow: hidden;
  }
  .card[hidden] { display: none; }
  .card:hover { box-shadow: inset 0 0 0 1px var(--c), 0 16px 34px -18px color-mix(in srgb, var(--c) 60%, #000); }
  .card[aria-selected='true'] { box-shadow: inset 0 0 0 2px var(--c), 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent), 0 20px 40px -18px color-mix(in srgb, var(--c) 70%, #000); }
  .cards:has(.card[aria-selected='true']) .card:not([aria-selected='true']) { opacity: 0.72; }
  .card:focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; }
  .shine { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(260px 160px at var(--sx, -30%) 0%, rgba(255, 255, 255, 0.16), transparent 70%); }
  .top { display: flex; justify-content: space-between; align-items: flex-start; }
  .rating { display: flex; flex-direction: column; line-height: 0.95; }
  .rating b { font-weight: 900; font-style: italic; font-size: 2rem; color: var(--c); }
  .rating small { font-size: 0.72rem; font-weight: 600; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.06em; }
  .tag { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); border: 1px solid var(--line); border-radius: 999px; padding: 3px 8px; }
  .card :global(.cpic) { border-radius: 10px; background: rgba(0, 0, 0, 0.35); color: var(--c); }
  .card :global(.pic-svg) { padding: 6px; }
  .cname { font-weight: 800; font-style: italic; font-size: 1.3rem; line-height: 1; letter-spacing: 0.01em; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; border-top: 1px solid var(--line); padding-top: 8px; }
  .facts span { display: flex; flex-direction: column; }
  .facts b { font: 700 0.9rem 'Barlow Condensed', sans-serif; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .facts small { font-size: 0.66rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.06em; }
  .hints { display: none; color: var(--ink-2); font-size: 0.85rem; gap: 6px; align-items: center; }
  @media (pointer: fine) { .hints { display: flex; } }

  .bio { background: var(--panel); border-left: 1px solid var(--line); overflow-y: auto; padding: clamp(18px, 3vw, 32px); padding-bottom: 80px; }
  .panel { display: flex; flex-direction: column; gap: 0.75rem; }
  .panel[hidden] { display: none; }
  .pcat { color: var(--c); font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0; }
  .panel h2 { font-weight: 900; font-style: italic; font-size: clamp(2.2rem, 4vw, 3.2rem); line-height: 0.95; margin: 0; }
  .what { color: var(--ink-2); font-size: 1.05rem; margin: 0; }
  .big { margin: 0.25rem 0 0.5rem; font-weight: 600; color: var(--ink-2); }
  .big b { font-weight: 900; font-style: italic; font-size: 3rem; color: var(--c); margin-right: 0.3rem; }
  .panel :global(.detail) { display: flex; flex-direction: column; gap: 1rem; }
  .panel :global(.d-meta) { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 0; font-size: 0.92rem; }
  .panel :global(.d-meta div) { display: contents; }
  .panel :global(.d-meta dt) { color: var(--ink-2); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.06em; padding-top: 2px; }
  .panel :global(.d-meta dd) { margin: 0; }
  .panel :global(.d-cols) { display: grid; gap: 1rem; }
  .panel :global(.d-h) { font-weight: 800; font-style: italic; font-size: 1.25rem; letter-spacing: 0.02em; margin: 0 0 0.5rem; color: var(--c); }
  .panel :global(.d-list) { list-style: none; display: flex; flex-direction: column; gap: 0.45rem; }
  .panel :global(.d-list li) { padding-left: 1rem; position: relative; line-height: 1.4; }
  .panel :global(.d-list li::before) { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; background: var(--c); transform: skewX(-12deg); }
  .panel :global(figure) { margin: 0; background: var(--panel-2); border-radius: 12px; padding: 12px; }
  .panel :global(video), .panel :global(.d-fig img) { width: 100%; border-radius: 8px; display: block; }
  .panel :global(.d-fig img) { max-height: 60vh; object-fit: contain; background: #000; }
  .panel :global(figcaption), .panel :global(.d-note) { color: var(--ink-2); font-size: 0.85rem; margin-top: 8px; }
  .panel :global(.d-fg) { --fg-ink: #eef2ff; --fg-accent: var(--violet); --fg-on-ink: #06080e; }
  .panel :global(.chart) { overflow-x: auto; display: grid; justify-items: center; }
  .panel :global(.d-links) { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .panel :global(.d-links a) { font: 800 italic 1.05rem 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.04em; color: #06080e; background: var(--violet); padding: 10px 18px; border-radius: 8px; text-decoration: none; }

  .profile { display: grid; gap: clamp(1.5rem, 4vw, 3rem); grid-template-columns: minmax(0, 1fr); padding: clamp(24px, 5vw, 64px) clamp(16px, 4vw, 48px) 120px; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .profile { grid-template-columns: 300px minmax(0, 1fr); } }
  .profile img { width: 100%; max-width: 300px; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  .pinfo { max-width: 52rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .pinfo h2 { font-weight: 900; font-style: italic; font-size: clamp(2.2rem, 4vw, 3rem); margin: 0; }
  .pinfo h3 { font-weight: 800; font-style: italic; font-size: 1.3rem; color: var(--violet); margin: 1rem 0 0.2rem; letter-spacing: 0.03em; }
  .pfacts { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .pfacts li { background: var(--panel); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; box-shadow: inset 0 0 0 1px var(--line); }
  .pfacts small { color: var(--ink-2); text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.08em; }
  .career { border-collapse: collapse; width: 100%; font-size: 0.98rem; }
  .career td { padding: 9px 8px; border-bottom: 1px solid var(--line); }
  .career td:first-child { font: 700 1rem 'Barlow Condensed', sans-serif; color: var(--ink-2); width: 5.5rem; }
  .career td:nth-child(2) { font-weight: 600; }
  .career td:last-child { color: var(--ink-2); }
  .news { display: flex; flex-direction: column; gap: 4px; background: var(--panel); border-radius: 12px; padding: 14px 16px; text-decoration: none; color: inherit; box-shadow: inset 0 0 0 1px var(--line); }
  .news:hover { box-shadow: inset 0 0 0 1px var(--violet); }
  .news b { font: 800 italic 1.3rem 'Barlow Condensed', sans-serif; text-transform: uppercase; }
  .news span { color: var(--ink-2); }
  .traits { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .traits li { padding: 6px 12px; border-radius: 8px; background: var(--panel-2); font-weight: 600; font-size: 0.9rem; }
  .contact { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .contact a { font: 800 italic 1.05rem 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); padding: 10px 16px; border-radius: 8px; text-decoration: none; box-shadow: inset 0 0 0 2px var(--line); }
  .contact a:first-child { background: var(--violet); color: #06080e; box-shadow: none; }
  .contact a:hover { box-shadow: inset 0 0 0 2px var(--violet); }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; transform: none; } }
</style>
