---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/600.css';
import Bare from '../../layouts/Bare.astro';
import Pic from '../../components/shared/Pic.astro';
import Detail from '../../components/shared/Detail.astro';
import { entries, CATS, type Cat } from '../../data/entries';

// Each project lives in one world (its primary category). Worlds read like a game's world map.
const worldOf = (e: (typeof entries)[number]): Cat => e.plate === 'ai' ? 'ai' : e.cats[0];
const worlds = CATS.map((c, wi) => ({
  ...c,
  n: wi + 1,
  stages: entries.filter((e) => worldOf(e) === c.id),
}));
const scores = worlds.flatMap((w) => w.stages.map((e, si) => ({ id: `${w.n}-${si + 1}`, name: e.name, v: e.stat.value, l: e.stat.label })));
---
<Bare title="Eshaan Dhavala · Arcade preview" theme="arcade" bg="#0b0b14">
  <div class="a">
    <section class="title-screen" aria-labelledby="t">
      <p class="credit">© 2026 UCLA STATS</p>
      <h1 id="t"><span>Eshaan</span><span>Dhavala</span></h1>
      <p class="tag">Statistics &amp; Data Science · Sports analytics · ML</p>
      <a class="start" href="#map">Press start</a>
      <div class="p1">
        <img src="/img/eshaan-pixel.png" alt="Eshaan Dhavala, pixel portrait" width="320" height="320" />
        <span>Player 1</span>
      </div>
    </section>

    <section id="map" class="map" aria-labelledby="map-h">
      <h2 id="map-h">Select stage</h2>
      <div class="worlds">
        {worlds.map((w) => (
          <div class="world" data-world={w.id}>
            <h3><span class="wn">World {w.n}</span> {w.label}</h3>
            <ol class="path">
              {w.stages.map((e, si) => (
                <li>
                  <button type="button" class="stage" data-stage={e.slug} aria-pressed={w.n === 1 && si === 0 ? 'true' : 'false'}>
                    <span class="num">{w.n}-{si + 1}</span>
                    <span class="sname">{e.name}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <p class="keys" aria-hidden="true">Arrow keys move · Enter play</p>
    </section>

    <section class="screen" aria-live="polite">
      {entries.map((e, i) => (
        <article class="stage-card" data-card={e.slug} hidden={i !== entries.findIndex((x) => worldOf(x) === 'football')}>
          <div class="sc-head">
            <Pic e={e} class="sc-pic" />
            <div class="sc-info">
              <p class="sc-num">Stage {worlds.find((w) => w.id === worldOf(e))!.n}-{worlds.find((w) => w.id === worldOf(e))!.stages.indexOf(e) + 1}</p>
              <h3>{e.name}</h3>
              <p class="sc-what">{e.what}</p>
              <p class="hiscore"><span>Hi-score</span> <b>{e.stat.value}</b> {e.stat.label}</p>
            </div>
          </div>
          <Detail e={e} />
        </article>
      ))}
    </section>

    <section class="scores" aria-labelledby="hs">
      <h2 id="hs">Stage records</h2>
      <ol>
        {scores.map((s) => (
          <li><span class="rk">{s.id}</span><span class="sn">{s.name}</span><span class="sv">{s.v} <small>{s.l}</small></span></li>
        ))}
      </ol>
    </section>

    <section class="about" aria-labelledby="ab">
      <h2 id="ab">Player 1</h2>
      <ul class="stats">
        <li><span>Class</span><b>Stats &amp; Data Science, UCLA, Dec 2027</b></li>
        <li><span>Guild</span><b>Bruin Sports Analytics, football co-chair</b></li>
        <li><span>Last quest</span><b>Data science intern, USAA, summer 2026</b></li>
        <li><span>Next quest</span><b>2027 roles: data science, ML, sports analytics</b></li>
      </ul>
      <a class="lore" href="https://plhswave.org/4411/features/study-hard-crunch-harder/">
        <b>Lore: “Study hard, crunch harder”</b>
        <span>My high school paper, The Wave, ran a feature on me and my Taco Bell order (Apr 2024).</span>
      </a>
      <p class="inv"><span>Inventory</span> Football · UFC · Weightlifting · Music theory · Co-op puzzle games · Japanese art history · Astronomy</p>
      <p class="cont">
        <a href="mailto:eshaandhavala@gmail.com">Email</a>
        <a href="/resume.pdf">Résumé</a>
        <a href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
        <a href="https://github.com/EshaanDhavala">GitHub</a>
      </p>
      <p class="over">Thanks for playing</p>
    </section>
  </div>
</Bare>

<script>
  const stages = [...document.querySelectorAll<HTMLButtonElement>('.stage')];
  const cards = document.querySelectorAll<HTMLElement>('[data-card]');
  function pick(b: HTMLButtonElement, go = false) {
    stages.forEach((s) => s.setAttribute('aria-pressed', String(s === b)));
    cards.forEach((c) => (c.hidden = c.dataset.card !== b.dataset.stage));
    window.dispatchEvent(new Event('resize'));
    if (go) document.querySelector('.screen')!.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
  stages.forEach((s) => s.addEventListener('click', () => pick(s, true)));
  document.addEventListener('keydown', (e) => {
    if (!document.activeElement?.classList.contains('stage')) return;
    const i = stages.indexOf(document.activeElement as HTMLButtonElement);
    const move = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
    if (move) { e.preventDefault(); const n = stages[Math.max(0, Math.min(stages.length - 1, i + move))]; n.focus(); pick(n); }
  });
</script>

<style>
  :global(html[data-preview='arcade']) {
    --bg: #0b0b14; --ink: #f4f1e8; --ink-2: #b9b3a3; --violet: #ffd23f; --sauce: #ff5d73;
    --cyan: #4cc9f0; --green: #6ee36e; --line: #2b2a3d;
    background: var(--bg); color: var(--ink); color-scheme: dark;
  }
  :global(html[data-preview='arcade'] body) { margin: 0; font-family: 'Pixelify Sans', system-ui, sans-serif; font-size: 1.08rem; line-height: 1.5; background: var(--bg); }
  :global(html[data-preview='arcade'] ::selection) { background: var(--violet); color: #0b0b14; }
  /* CRT scanlines: the screen's own texture */
  .a::after { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 50; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; }
  h1, h2, h3, .start, .num, .sc-num, .hiscore span, .rk, .over, .stats span, .inv span, .wn { font-family: 'Press Start 2P', monospace; }
  h2 { font-size: clamp(1rem, 2.4vw, 1.5rem); color: var(--violet); text-align: center; margin: 0 0 1.5rem; letter-spacing: 0.04em; }

  .title-screen { min-height: 100dvh; display: grid; place-items: center; align-content: center; gap: 1.4rem; text-align: center; padding: 48px 16px; position: relative; }
  .credit { position: absolute; bottom: 72px; left: 0; right: 0; font-family: 'Press Start 2P', monospace; font-size: 0.6rem; color: var(--ink-2); margin: 0; }
  h1 { margin: 0; display: flex; flex-direction: column; gap: 0.3em; font-size: clamp(1.8rem, 7vw, 4.6rem); line-height: 1; color: var(--ink); text-shadow: 4px 4px 0 var(--sauce), 8px 8px 0 #2b1a44; }
  .tag { margin: 0; color: var(--cyan); font-size: 1.15rem; }
  .start { color: var(--violet); text-decoration: none; font-size: clamp(0.8rem, 2vw, 1rem); padding: 14px 18px; animation: blink 1.1s steps(2, start) infinite; }
  .start:hover, .start:focus-visible { animation: none; background: var(--violet); color: #0b0b14; outline: none; }
  @keyframes blink { to { visibility: hidden; } }
  .p1 { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .p1 img { width: 120px; height: 120px; image-rendering: pixelated; border: 4px solid var(--ink); background: #222; filter: contrast(1.1); }
  .p1 span { font-family: 'Press Start 2P', monospace; font-size: 0.6rem; color: var(--ink-2); }

  .map { padding: 64px clamp(16px, 4vw, 48px) 32px; max-width: 1200px; margin: 0 auto; }
  .worlds { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .world { border: 4px solid var(--line); padding: 16px; background: #12121e; }
  .world h3 { font-size: 0.72rem; line-height: 1.6; margin: 0 0 14px; color: var(--ink); }
  .wn { display: block; color: var(--cyan); margin-bottom: 4px; }
  .path { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .path li { position: relative; }
  .path li + li::before { content: ''; position: absolute; left: 26px; top: -12px; height: 12px; border-left: 4px dotted var(--line); }
  .stage { width: 100%; display: flex; align-items: center; gap: 12px; text-align: left; cursor: pointer; padding: 10px; background: #0b0b14; color: var(--ink); border: 4px solid var(--line); font: 600 1rem 'Pixelify Sans', sans-serif; }
  .stage:hover { border-color: var(--cyan); }
  .stage[aria-pressed='true'] { border-color: var(--violet); background: #1d1a0c; }
  .stage:focus-visible { outline: 4px solid var(--sauce); outline-offset: 2px; }
  .num { font-size: 0.6rem; background: var(--violet); color: #0b0b14; padding: 8px 6px; flex: none; }
  .keys { text-align: center; color: var(--ink-2); margin-top: 1.5rem; font-size: 0.95rem; }

  .screen { max-width: 1100px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) 48px; scroll-margin-top: 16px; }
  .stage-card { border: 4px solid var(--violet); background: #12121e; padding: clamp(16px, 3vw, 28px); display: flex; flex-direction: column; gap: 1.25rem; box-shadow: 8px 8px 0 #2b1a44; }
  .stage-card[hidden] { display: none; }
  .sc-head { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 820px) { .sc-head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .stage-card :global(.sc-pic) { border: 4px solid var(--line); background: #0b0b14; color: var(--green); image-rendering: pixelated; }
  .stage-card :global(.pic-svg) { padding: 10px; }
  .sc-info { display: flex; flex-direction: column; gap: 10px; }
  .sc-num { margin: 0; font-size: 0.65rem; color: var(--cyan); }
  .sc-info h3 { margin: 0; font-size: clamp(1rem, 2.6vw, 1.6rem); line-height: 1.4; }
  .sc-what { margin: 0; color: var(--ink-2); }
  .hiscore { margin: 0; font-size: 1.1rem; }
  .hiscore span { font-size: 0.6rem; color: var(--sauce); margin-right: 8px; }
  .hiscore b { font-size: 1.8rem; color: var(--violet); }
  .stage-card :global(.d-meta) { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 0; }
  .stage-card :global(.d-meta div) { display: contents; }
  .stage-card :global(.d-meta dt) { color: var(--cyan); }
  .stage-card :global(.d-meta dd) { margin: 0; }
  .stage-card :global(.d-cols) { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .stage-card :global(.d-h) { font-family: 'Press Start 2P', monospace; font-size: 0.7rem; color: var(--violet); margin: 0 0 12px; line-height: 1.6; }
  .stage-card :global(.d-list) { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .stage-card :global(.d-list li) { padding-left: 22px; position: relative; }
  .stage-card :global(.d-list li::before) { content: ''; position: absolute; left: 0; top: 0.45em; width: 10px; height: 10px; background: var(--green); }
  .stage-card :global(.d-results li::before) { background: var(--violet); }
  .stage-card :global(figure) { margin: 0; border: 4px solid var(--line); padding: 10px; background: #0b0b14; }
  .stage-card :global(video), .stage-card :global(.d-fig img) { width: 100%; display: block; }
  .stage-card :global(.d-fig img) { max-height: 60vh; object-fit: contain; }
  .stage-card :global(figcaption), .stage-card :global(.d-note) { color: var(--ink-2); font-size: 0.95rem; margin-top: 8px; }
  .stage-card :global(.d-fg) { --fg-ink: #f4f1e8; --fg-accent: #ffd23f; --fg-on-ink: #0b0b14; }
  .stage-card :global(.chart) { overflow-x: auto; display: grid; justify-items: center; }
  .stage-card :global(.d-links) { display: flex; gap: 10px; flex-wrap: wrap; margin: 0; }
  .stage-card :global(.d-links a) { font: 0.65rem 'Press Start 2P', monospace; color: #0b0b14; background: var(--violet); padding: 12px 14px; text-decoration: none; box-shadow: 4px 4px 0 #2b1a44; }

  .scores { max-width: 760px; margin: 0 auto; padding: 48px 16px; }
  .scores ol { list-style: none; padding: 0; margin: 0; }
  .scores li { display: grid; grid-template-columns: 3rem 1fr auto; gap: 12px; align-items: baseline; padding: 8px 4px; border-bottom: 2px dashed var(--line); }
  .rk { font-size: 0.7rem; color: var(--cyan); }
  .sn { font-weight: 600; }
  .sv { font-weight: 600; color: var(--green); white-space: nowrap; }
  .sv small { color: var(--ink-2); font-weight: 400; }

  .about { max-width: 820px; margin: 0 auto; padding: 48px 16px 140px; display: flex; flex-direction: column; gap: 18px; }
  .stats { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .stats li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; align-items: baseline; }
  .stats span, .inv span { font-size: 0.6rem; color: var(--cyan); }
  .lore { display: flex; flex-direction: column; gap: 6px; border: 4px solid var(--line); padding: 14px; text-decoration: none; color: inherit; }
  .lore:hover { border-color: var(--violet); }
  .lore b { color: var(--violet); }
  .lore span { color: var(--ink-2); }
  .inv { margin: 0; }
  .cont { display: flex; gap: 10px; flex-wrap: wrap; margin: 0; }
  .cont a { font: 0.65rem 'Press Start 2P', monospace; color: var(--ink); border: 4px solid var(--ink); padding: 12px 14px; text-decoration: none; }
  .cont a:first-child { background: var(--violet); color: #0b0b14; border-color: var(--violet); }
  .cont a:hover { border-color: var(--violet); }
  .over { text-align: center; color: var(--sauce); font-size: 0.8rem; margin-top: 2rem; }
  @media (max-width: 560px) { .stats li { grid-template-columns: 1fr; gap: 2px; } }
  @media (prefers-reduced-motion: reduce) { .start { animation: none; } }
</style>
