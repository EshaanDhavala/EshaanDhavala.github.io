---
import Kiosk from '../layouts/Kiosk.astro';
import MenuTile from '../components/MenuTile.astro';
import FgLive from '../components/FgLive.astro';
import Icon from '../components/Icon.astro';
import { entries, CATS } from '../data/entries';

const experience = [
  ['Data Science Intern', 'USAA', 'May – Aug 2026'],
  ['Co-Chair & Research Analyst', 'Bruin Sports Analytics · Football', 'Jan 2026 – now'],
  ['Data Analyst', 'Bruin Sports Analytics · Tennis', 'Mar 2025 – Jun 2026'],
  ['Lead Host', 'Mystic Lake Casino Steakhouse', 'Apr 2024 – Apr 2026'],
];
const interests = ['Football', 'UFC', 'Weightlifting', 'Music theory', 'Co-op puzzle games', 'Japanese art history', 'Astronomy'];
---
<Kiosk>
  <h1 class="visually-hidden">Eshaan Dhavala: projects</h1>
  <div class="shell">
    <nav class="rail" aria-label="Menu categories">
      <div class="rail-inner">
        <button type="button" class="cat" data-filter="all" aria-pressed="true">All <span>{entries.length}</span></button>
        {CATS.map((c) => (
          <button type="button" class="cat" data-filter={c.id} aria-pressed="false">
            {c.label} <span>{entries.filter((e) => e.cats.includes(c.id)).length}</span>
          </button>
        ))}
        <a class="cat" href="#about">About</a>
      </div>
    </nav>

    <div class="content">
      <section class="promo" aria-labelledby="promo-title">
        <div class="promo-head">
          <div>
            <h2 id="promo-title">4th-Down OT Engine</h2>
            <p>My NFL field-goal model, live. Move the kick.</p>
          </div>
          <div class="promo-actions">
            <span class="chip">0.78 <small>AUC</small></span>
            <a class="btn btn-onplate" href="/entries/nfl-overtime-4th-down/">Details <Icon name="arrow-right" size={18} /></a>
          </div>
        </div>
        <FgLive />
      </section>

      <section id="menu" aria-labelledby="menu-title">
        <div class="sec-head">
          <h2 id="menu-title" data-menu-title>Everything</h2>
          <p class="count" data-menu-count>{entries.length} items</p>
        </div>
        <div class="grid">
          {entries.map((e, i) => <MenuTile e={e} eager={i < 4} />)}
        </div>
      </section>

      <section id="about" class="about" aria-labelledby="about-title">
        <img class="photo" src="/img/eshaan.jpg" alt="Eshaan Dhavala" width="900" height="900" loading="lazy" />
        <div class="about-body">
          <h2 id="about-title">Hi, I’m Eshaan.</h2>
          <ul class="facts">
            <li>Stats &amp; Data Science at UCLA, graduating Dec 2027</li>
            <li>Co-chair of Bruin Sports Analytics football</li>
            <li>Data science intern at USAA, summer 2026</li>
            <li>Looking for 2027 roles in data science, ML, and sports analytics</li>
          </ul>
          <div class="about-cta">
            <a class="btn btn-sauce" href="mailto:eshaandhavala@gmail.com"><Icon name="mail" size={18} /> Email</a>
            <a class="btn btn-ghost" href="/resume.pdf"><Icon name="file" size={18} /> Résumé</a>
            <a class="btn btn-ghost" href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
            <a class="btn btn-ghost" href="https://github.com/EshaanDhavala">GitHub</a>
          </div>

          <h3>Experience</h3>
          <ul class="exp">
            {experience.map(([role, org, when]) => (<li><b>{role}</b><span>{org}</span><span class="when">{when}</span></li>))}
          </ul>

          <h3>In the paper</h3>
          <a class="press" href="https://plhswave.org/4411/features/study-hard-crunch-harder/">
            <span class="press-title">“Study hard, crunch harder”</span>
            <span class="press-text">My high school paper ran a feature on me and my Taco Bell order. That’s why this site is a kiosk.</span>
            <span class="press-quote">“The closest one is 10 minutes away and 7 minutes if I’m really hungry.”</span>
            <span class="press-meta">The Wave, Prior Lake High School, April 2024</span>
            <span class="press-link">Read the article <Icon name="external" size={16} /></span>
          </a>

          <h3>Outside of this</h3>
          <ul class="interests">{interests.map((i) => <li class="tag">{i}</li>)}</ul>
        </div>
      </section>
    </div>
  </div>
</Kiosk>

<script>
  function setupFilter() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.rail [data-filter]');
    const tiles = document.querySelectorAll<HTMLElement>('#menu .tile');
    const title = document.querySelector<HTMLElement>('[data-menu-title]');
    const count = document.querySelector<HTMLElement>('[data-menu-count]');
    function apply(b: HTMLButtonElement, scroll: boolean) {
        const f = b.dataset.filter!;
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let n = 0;
        tiles.forEach((t) => {
          const show = f === 'all' || t.dataset.cats!.split(' ').includes(f);
          t.hidden = !show;
          if (show) n++;
        });
        if (title) title.textContent = f === 'all' ? 'Everything' : b.firstChild!.textContent!.trim();
        if (count) count.textContent = `${n} ${n === 1 ? 'item' : 'items'}`;
        const url = new URL(location.href);
        f === 'all' ? url.searchParams.delete('cat') : url.searchParams.set('cat', f);
        history.replaceState(history.state, '', url);
        if (scroll) document.getElementById('menu')!.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }
    btns.forEach((b) => b.addEventListener('click', () => apply(b, true)));
    const initial = new URL(location.href).searchParams.get('cat');
    const start = [...btns].find((b) => b.dataset.filter === initial);
    if (start) apply(start, false);
  }
  document.addEventListener('astro:page-load', setupFilter);
</script>

<style>
  .shell { display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .shell { grid-template-columns: 216px minmax(0, 1fr); } }

  .rail { position: sticky; top: 68px; z-index: 10; background: var(--violet); color: var(--violet-ink); }
  .rail-inner { display: flex; gap: 0.4rem; padding: 0.6rem 16px; overflow-x: auto; scrollbar-width: none; }
  .rail-inner::-webkit-scrollbar { display: none; }
  .cat {
    flex: none; display: inline-flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    min-height: 44px; padding: 0 1rem; border-radius: 999px; border: 0; cursor: pointer; text-decoration: none;
    background: transparent; color: inherit; font-weight: 800; font-stretch: 112%; font-size: 1rem;
  }
  .cat span { font-size: 0.8rem; font-weight: 700; opacity: 0.7; }
  .cat:hover { background: rgba(255, 255, 255, 0.14); }
  .cat[aria-pressed='true'] { background: #fff; color: var(--violet-2); }
  .cat[aria-pressed='true'] span { opacity: 1; }
  @media (min-width: 1000px) {
    .rail { height: calc(100dvh - 68px); }
    .rail-inner { flex-direction: column; padding: 1.25rem 0.85rem; overflow: visible; }
    .cat { min-height: 52px; font-size: 1.08rem; padding: 0 1rem; border-radius: 12px; }
    .cat[href='#about'] { margin-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.22); border-radius: 0 0 12px 12px; padding-top: 1.25rem; min-height: 64px; }
  }

  .content { padding: clamp(16px, 2.5vw, 32px); padding-bottom: 0; display: flex; flex-direction: column; gap: 3.5rem; min-width: 0; }

  .promo {
    --fg-ink: #fff; --fg-accent: #ff5a1f; --fg-on-ink: #0f3d25;
    background: var(--football); color: #fff; border-radius: 22px; padding: clamp(18px, 3vw, 32px);
    display: flex; flex-direction: column; gap: 1.5rem;
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 10% 100%;
  }
  .promo-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; }
  .promo h2 { font-size: clamp(2rem, 4.6vw, 3.4rem); font-stretch: 125%; }
  .promo-head p { margin-top: 0.4rem; font-size: 1.05rem; opacity: 0.88; font-weight: 500; }
  .promo-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .promo .chip { font-size: 1.05rem; }
  @media (max-width: 640px) {
    .promo { gap: 1rem; padding: 18px; }
    .promo-head p { display: none; }
    .promo-actions .btn { min-height: 44px; padding: 0 1rem; font-size: 0.95rem; }
    .promo :global(.curve) { display: none; }
    .promo :global(.pct) { font-size: 3.2rem; }
    .promo :global(.controls) { gap: 0.6rem; }
    .promo :global(.controls fieldset) { display: none; }
    .promo-head { gap: 0.75rem; }
    .promo-actions { gap: 0.4rem; }
    .promo-actions .btn { min-height: 40px; padding: 0 0.85rem; font-size: 0.9rem; }
  }
  .promo .btn-sauce[aria-pressed='true'] { background: #fff; color: #0f3d25; }
  .btn-onplate { color: #fff; box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.45); background: transparent; }
  .btn-onplate:hover { box-shadow: inset 0 0 0 2px #fff; }

  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; }
  .sec-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-stretch: 125%; }
  .count { color: var(--ink-2); font-weight: 700; }
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 248px), 1fr)); }
  .grid :global(.tile[hidden]) { display: none; }


  .about {
    display: grid; gap: clamp(1.25rem, 3vw, 2.5rem); grid-template-columns: minmax(0, 1fr);
    background: var(--tile); border-radius: 22px; padding: clamp(18px, 3vw, 36px); box-shadow: var(--shadow);
  }
  @media (min-width: 820px) { .about { grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr); align-items: start; } }
  .photo { width: 100%; max-width: 300px; aspect-ratio: 1; object-fit: cover; border-radius: 16px; background: var(--screen); }
  @media (min-width: 820px) { .photo { position: sticky; top: 100px; } }
  .about-body { display: flex; flex-direction: column; gap: 1rem; max-width: 46rem; }
  .about h2 { font-size: clamp(2rem, 4vw, 2.8rem); font-stretch: 125%; }
  .about h3 { font-size: 1.15rem; font-stretch: 118%; margin-top: 1.25rem; }
  .facts { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; font-size: 1.05rem; }
  .facts li { padding-left: 1.1rem; position: relative; }
  .facts li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 7px; border-radius: 2px; background: var(--sauce); }
  .about-cta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .exp { list-style: none; display: flex; flex-direction: column; }
  .exp li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) { .exp li { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto; align-items: baseline; } }
  .exp span { color: var(--ink-2); }
  .exp .when { font-size: 0.9rem; }
  .press {
    display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none;
    background: var(--screen); border-radius: var(--r); padding: 1.1rem 1.2rem; transition: background-color 140ms ease-out;
  }
  .press:hover { background: color-mix(in srgb, var(--violet) 10%, var(--screen)); }
  .press-meta { font-size: 0.82rem; font-weight: 700; color: var(--ink-2); }
  .press-title { font-weight: 800; font-stretch: 118%; font-size: 1.3rem; }
  .press-text { color: var(--ink-2); }
  .press-quote { font-weight: 600; }
  .press-link { display: inline-flex; gap: 0.35rem; align-items: center; font-weight: 800; color: var(--violet); }
  .interests { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
</style>
