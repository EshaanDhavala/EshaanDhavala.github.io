---
import Notebook from '../layouts/Notebook.astro';
import { entries, TAGS } from '../data/entries';

const experience = [
  {
    when: 'May – Aug 2026',
    where: 'USAA',
    place: 'San Antonio, TX',
    role: 'Data Science Intern',
    did: 'Found that 72% of a year’s card closures were logged under one vague code, then used BERTopic on call transcripts to recover the real reasons. Capture rate went from 28% to 66%. Presented three process fixes to senior leadership.',
    entry: 'usaa-closure-reasons',
  },
  {
    when: 'Jan 2026 – now',
    where: 'Bruin Sports Analytics · Football',
    place: 'UCLA',
    role: 'Co-Chair & Research Analyst',
    did: 'Lead a 6-person team rebuilding UCLA Football’s strength-data pipeline and dashboard, and built its AI assistant. Run weekly research meetings across 3 projects and recruited 6 new members.',
    entry: 'ucla-football-ai-assistant',
  },
  {
    when: 'Mar 2025 – Jun 2026',
    where: 'Bruin Sports Analytics · Tennis',
    place: 'UCLA',
    role: 'Data Analyst',
    did: 'Serve-accuracy and shot-selection ETL over a 26-match season, match data sourced by hand from video for 12 untracked away matches, scouting graphics for 8 opponents, and a travel dashboard players used.',
    entry: 'tennis-scouting',
  },
  {
    when: 'Apr 2024 – Apr 2026',
    where: 'Mystic Lake Casino Steakhouse',
    place: 'Prior Lake, MN',
    role: 'Server Assist & Lead Host',
    did: 'Seated 300+ guests a night and fit 25-party walk-in waitlists into fully booked service: a live optimization problem, just without the code.',
  },
];

const offClock = [
  ['Football', 'the reason most of this notebook exists'],
  ['UFC', 'five-round, small-sample problems'],
  ['Weightlifting', 'logged nightly in entry No. 06'],
  ['Music theory', 'chord progressions are just sequences'],
  ['Co-op puzzle games', 'two people, one brain cell'],
  ['Japanese art history', 'ask me about it'],
  ['Astronomy', 'the original big dataset'],
];
---
<Notebook>
  <!-- Cover -->
  <section class="cover">
    <div class="cover-text ink-in">
      <p class="label">Vol. 1 · B.S. Statistics &amp; Data Science · UCLA, Dec 2027</p>
      <h1>Eshaan Dhavala keeps a notebook of things he’s measured.</h1>
      <p class="lede">
        Field goals, quarterback pockets, tennis returns, credit-card phone calls, and 131 nights of my own
        journal. Most of my work starts with a sports question and ends as a model, a tool someone actually
        uses, or a data bug nobody had noticed yet.
      </p>
      <p class="now mono">
        <span class="label">Currently</span><br />
        co-chair, Bruin Sports Analytics football · open to 2027 roles in data science, ML, and sports analytics
      </p>
      <p class="cta mono">
        <a href="#entries">Read the entries ↓</a>
        <a href="/resume.pdf">Résumé (PDF)</a>
        <a href="mailto:eshaandhavala@gmail.com">Email me</a>
      </p>
    </div>
    <figure class="polaroid taped">
      <img src="/img/eshaan.jpg" alt="Portrait of Eshaan Dhavala" width="600" height="600" />
      <figcaption class="hand">me, probably thinking about Taco Bell (see clippings)</figcaption>
    </figure>
  </section>

  <!-- Table of contents -->
  <section id="entries" class="toc">
    <div class="sec-head">
      <p class="label">Contents</p>
      <h2>Entries</h2>
    </div>
    <div class="filters" role="group" aria-label="Filter entries">
      <button type="button" data-filter="all" aria-pressed="true">All <span>{entries.length}</span></button>
      {TAGS.map((t) => (
        <button type="button" data-filter={t} aria-pressed="false">
          {t} <span>{entries.filter((e) => e.tags.includes(t)).length}</span>
        </button>
      ))}
    </div>
    <ol class="toc-list">
      {entries.map((e) => (
        <li data-tags={e.tags.join('|')}>
          <a href={`/entries/${e.slug}/`}>
            <span class="no mono">{String(e.no).padStart(2, '0')}</span>
            <span class="t">
              <span class="title">{e.title}</span>
              <span class="blurb">{e.blurb}</span>
              <span class="ctx mono">{e.context} · {e.when}</span>
            </span>
            <span class="hook mono"><mark>{e.hook}</mark></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Experience -->
  <section id="experience" class="exp">
    <div class="sec-head">
      <p class="label">Where the work happened</p>
      <h2>Experience</h2>
    </div>
    <ol class="exp-list">
      {experience.map((x) => (
        <li>
          <p class="when mono">{x.when}</p>
          <div>
            <h3>{x.role}, <span class="where">{x.where}</span></h3>
            <p class="place label">{x.place}</p>
            <p>{x.did}</p>
            {x.entry && <p class="mono small"><a href={`/entries/${x.entry}/`}>see the entry →</a></p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Clippings -->
  <section id="clippings" class="clip-sec">
    <div class="sec-head">
      <p class="label">Pasted in</p>
      <h2>Clippings</h2>
    </div>
    <article class="clipping taped">
      <p class="masthead">The Wave <span>· Prior Lake High School student news · Features · April 23, 2024</span></p>
      <h3>Study hard, crunch harder</h3>
      <p class="byline">By Ryan Gegenheimer</p>
      <div class="cols">
        <p>
          A senior near the top of his class, and a Taco Bell regular: twice a week, then nearly every day once
          he could drive. His older brother taught him to swap beef for beans, and the staff know his car by now.
          His order is the build-your-own Cravings Box, and he calls it “balance in life.”
        </p>
        <blockquote>
          “The closest one is 10 minutes away and 7 minutes if I’m really hungry. The people there all know me,
          and they know when I pull up.”
        </blockquote>
      </div>
      <p class="mono small"><a href="https://plhswave.org/4411/features/study-hard-crunch-harder/" rel="noopener">Read the full feature on plhswave.org ↗</a></p>
    </article>
    <p class="hand clip-note">still accurate. the drive is longer now.</p>
  </section>

  <!-- Off the clock -->
  <section id="off-the-clock" class="off">
    <div class="sec-head">
      <p class="label">Margins</p>
      <h2>Off the clock</h2>
    </div>
    <ul class="off-list">
      {offClock.map(([k, v], i) => (
        <li style={`--r:${(i % 2 ? 1 : -1) * (0.6 + (i % 3) * 0.4)}deg`}>
          <span class="k">{k}</span>
          <span class="v hand">{v}</span>
        </li>
      ))}
    </ul>
  </section>
</Notebook>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const rows = document.querySelectorAll<HTMLLIElement>('.toc-list li');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      rows.forEach((r) => {
        r.hidden = f !== 'all' && !r.dataset.tags!.split('|').includes(f);
      });
    }),
  );
</script>

<style>
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.5rem 0 1rem;
    align-items: start;
  }
  @media (min-width: 880px) {
    .cover { grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr); padding-top: 5rem; }
  }
  .cover h1 {
    font-size: clamp(2.4rem, 6.2vw, 4.6rem);
    line-height: 1.02;
    margin: 0.8rem 0 1.4rem;
    max-width: 14ch;
  }
  .lede { font-size: 1.2rem; max-width: 36rem; color: var(--ink-soft); }
  .now { color: var(--ink-soft); margin-top: 1.5rem; line-height: 1.6; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin-top: 1.8rem; }
  .polaroid {
    margin: 1rem auto 0;
    max-width: min(18rem, 80%);
    background: var(--plate);
    padding: 0.8rem 0.8rem 0.4rem;
    box-shadow: var(--shadow);
    transform: rotate(2.5deg);
  }
  .polaroid figcaption { text-align: center; font-size: 1.05rem; color: var(--ink-soft); padding: 0.5rem 0 0.2rem; line-height: 1.25; }

  section { scroll-margin-top: 1rem; }
  .sec-head { margin: 4rem 0 1.5rem; }
  .sec-head h2 { margin-top: 0.3rem; font-size: clamp(2rem, 4vw, 2.8rem); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .filters button {
    font-family: var(--mono);
    font-size: 0.8rem;
    background: transparent;
    color: var(--ink-soft);
    border: 1px solid color-mix(in srgb, var(--pencil) 60%, transparent);
    border-radius: 3px 3px 0 0;
    border-bottom-width: 3px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .filters button span { color: var(--pencil); margin-left: 0.2rem; }
  .filters button[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--pen); background: var(--highlight); }

  .toc-list { list-style: none; padding: 0; margin: 0; }
  .toc-list li { border-bottom: 1px dashed color-mix(in srgb, var(--pencil) 50%, transparent); }
  .toc-list a {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
    padding: 1.3rem 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .toc-list .no { color: var(--pencil); padding-top: 0.35rem; }
  .toc-list .t { display: flex; flex-direction: column; gap: 0.3rem; }
  .toc-list .title { font-family: var(--serif-display); font-size: clamp(1.25rem, 2.4vw, 1.55rem); line-height: 1.2; }
  .toc-list .blurb { color: var(--ink-soft); font-size: 0.98rem; max-width: 40rem; }
  .toc-list .ctx { color: var(--pencil); font-size: 0.75rem; }
  .toc-list .hook { grid-column: 2; font-size: 0.85rem; }
  .toc-list a:hover .title { color: var(--pen); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  @media (min-width: 880px) {
    .toc-list a { grid-template-columns: 2.4rem minmax(0, 1fr) max-content; align-items: baseline; }
    .toc-list .hook { grid-column: auto; text-align: right; padding-left: 1.5rem; }
  }

  .exp-list { list-style: none; padding: 0; margin: 0; max-width: 46rem; }
  .exp-list li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.3rem 2rem; padding: 1.4rem 0; border-bottom: 1px dashed color-mix(in srgb, var(--pencil) 50%, transparent); }
  @media (min-width: 720px) { .exp-list li { grid-template-columns: 10rem minmax(0, 1fr); } }
  .exp-list .when { color: var(--pencil); margin: 0.2rem 0 0; }
  .exp-list h3 { font-size: 1.3rem; }
  .exp-list .where { font-style: italic; }
  .exp-list .place { margin: 0.3rem 0 0.6rem; }
  .small { font-size: 0.82rem; }

  .clipping {
    max-width: 44rem;
    background: #efe6cf;
    color: #2b2620;
    padding: 1.6rem 1.6rem 1.2rem;
    box-shadow: var(--shadow);
    transform: rotate(-1deg);
  }
  .clipping a { color: #1f4f8a; }
  .masthead { font-family: var(--serif-display); font-size: 1.4rem; border-bottom: 3px double #2b2620; padding-bottom: 0.3rem; margin-bottom: 1rem; }
  .masthead span { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; }
  .clipping h3 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 400; }
  .byline { font-family: var(--mono); font-size: 0.78rem; margin: 0.4rem 0 1rem; }
  .cols { display: grid; gap: 1rem 1.6rem; }
  @media (min-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
  .clipping blockquote { margin: 0; font-family: var(--serif-display); font-style: italic; font-size: 1.2rem; line-height: 1.35; border-left: 3px solid #2b2620; padding-left: 1rem; }
  .clip-note { color: var(--pen); font-size: 1.2rem; transform: rotate(-2deg); margin: 1rem 0 0 2rem; }

  .off-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 1rem; max-width: 52rem; }
  .off-list li {
    background: var(--plate);
    box-shadow: var(--shadow);
    padding: 0.8rem 1rem;
    transform: rotate(var(--r));
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 11rem;
  }
  .off-list .k { font-family: var(--serif-display); font-size: 1.15rem; }
  .off-list .v { color: var(--pen); font-size: 1rem; line-height: 1.3; }
</style>
