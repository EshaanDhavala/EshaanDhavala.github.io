---
import Game from '../layouts/Game.astro';
import Card from '../components/game/Card.astro';
import FgLive from '../components/FgLive.astro';
import HeroPlay from '../components/HeroPlay.astro';
import { entries, CATS } from '../data/entries';

const career = [
  ['Summer 2026', 'USAA', 'Data Science Intern'],
  ['2026 – now', 'Bruin Sports Analytics', 'Football Co-Chair & Research Analyst'],
  ['2025 – 2026', 'Bruin Sports Analytics', 'Tennis Data Analyst'],
  ['2024 – 2026', 'Mystic Lake Casino Steakhouse', 'Lead Host'],
  ['2022 – 2023', 'Tokyo Sushi and Grill', 'Host & Cashier'],
  ['2020 – 2021', 'Kumon', 'Tutor'],
];
const traits = ['Football', 'UFC', 'Weightlifting', 'Music theory', 'Co-op puzzle games', 'Japanese art history', 'Astronomy'];
const starters = entries.filter((e) => e.starter);
const bench = entries.filter((e) => !e.starter);
const ticker = [
  ['USAA', 'Data Science Intern, summer 2026'],
  ['playbyplay.football', 'live NFL overtime decision engine'],
  ['UCLA Football', 'AI assistant for the strength staff'],
  ['1,174 clips', 'hand-labeled for PlayScan'],
  ['131 nights', 'of journal entries turned into data'],
  ['26 matches', 'of UCLA Tennis data'],
  ['Bruin Sports Analytics', 'football co-chair'],
];
---
<Game>
  <section class="hero" data-parallax-root aria-labelledby="hero-title">
    <HeroPlay />
    <div class="hero-inner wrap">
      <div class="hero-text">
        <h1 id="hero-title" data-parallax="0.12"><span data-hero-in>Eshaan</span><span data-hero-in>Dhavala</span></h1>
        <p class="lede" data-hero-in>Stats &amp; Data Science at UCLA. I build sports models and AI tools, most recently an AI assistant for UCLA Football’s strength staff and the field-goal model in a live NFL overtime tool.</p>
        <ul class="proof" data-hero-in>
          <li>USAA Data Science Intern ’26</li>
          <li>Football co-chair, Bruin Sports Analytics</li>
          <li>Open to 2027 roles in DS, ML, sports analytics</li>
        </ul>
        <p class="cta" data-hero-in>
          <a class="btn btn-lime" href="#projects">Browse projects</a>
          <a class="btn btn-line" href="/resume.pdf">Résumé</a>
        </p>
      </div>
      <figure class="portrait" data-hero-in>
        <div class="ring"><img src="/img/eshaan-circle.jpg" alt="Eshaan Dhavala" width="800" height="800" fetchpriority="high" /></div>
        <figcaption><b>UCLA ’27</b><span>Bruin Sports Analytics co-chair</span></figcaption>
      </figure>
    </div>
    <div class="ticker" aria-label="Highlights">
      <ul class="tick" data-tick>
        {[0, 1].map((k) => ticker.map(([n, s]) => <li aria-hidden={k === 1 ? 'true' : undefined}><b>{n}</b> {s}</li>))}
      </ul>
      <button type="button" class="tick-pause" data-tick-toggle aria-pressed="false" aria-label="Pause highlights"><span></span></button>
    </div>
  </section>

  <section id="projects" class="projects wrap" aria-labelledby="projects-title">
    <div class="phead">
      <div>
        <h2 id="projects-title">Projects</h2>
        <p class="count" data-count-label>{entries.length} projects</p>
      </div>
      <div class="tabs" role="group" aria-label="Filter projects">
        <span class="kbd hint" aria-hidden="true">Q</span>
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {CATS.map((c) => <button type="button" data-filter={c.id} aria-pressed="false">{c.label}</button>)}
        <span class="kbd hint" aria-hidden="true">E</span>
        <span class="hint-txt hint" aria-hidden="true">keys to switch</span>
      </div>
    </div>
    <h3 class="group" data-group="starters">Featured</h3>
    <div class="grid starters" data-list="starters">
      {starters.map((e, i) => <div class="cell" data-reveal><Card e={e} big eager={i < 2} /></div>)}
    </div>
  </section>

  <section class="spot wrap" aria-labelledby="spot-title" data-reveal data-spot>
    <div class="spot-head">
      <h2 id="spot-title">Try the field-goal model</h2>
      <p>Real predictions from my XGBoost model (0.78 AUC). Move the kick.</p>
      <a class="btn btn-line" href="/entries/nfl-overtime-4th-down/">See the project</a>
    </div>
    <div class="spot-panel"><FgLive /></div>
  </section>

  <section class="wrap roster" aria-labelledby="roster-title">
    <h3 id="roster-title" class="group" data-group="bench">More projects</h3>
    <div class="grid" data-list="roster">
      {bench.map((e) => <div class="cell" data-bench data-reveal><Card e={e} /></div>)}
    </div>
  </section>

  <section id="profile" class="profile wrap" aria-labelledby="profile-title">
    <div class="p-main">
      <h2 id="profile-title" data-reveal>About me</h2>
      <ul class="tiles">
        <li data-reveal><small>Studying</small><b>Statistics &amp; Data Science, UCLA</b></li>
        <li data-reveal><small>Graduating</small><b>December 2027</b></li>
        <li data-reveal><small>Team</small><b>Bruin Sports Analytics, football co-chair</b></li>
        <li data-reveal><small>Looking for</small><b>2027 roles in data science, ML, sports analytics</b></li>
      </ul>
      <h3 data-reveal>Experience</h3>
      <table class="career" data-reveal>
        <tbody>{career.map(([y, t, r], i) => <tr class:list={{ minor: i >= 3 }}><td>{y}</td><td>{t}</td><td>{r}</td></tr>)}</tbody>
      </table>
      <h3 data-reveal>Interests</h3>
      <ul class="traits" data-reveal>{traits.map((t) => <li>{t}</li>)}</ul>
      <a class="news" href="https://plhswave.org/4411/features/study-hard-crunch-harder/" data-reveal>
        <span class="n-src">In the news</span>
        <span>My high school paper ran a feature on me and my Taco Bell order: <b>“Study hard, crunch harder”</b> (The Wave, 2024).</span>
      </a>
      <p class="contact" data-reveal>
        <a class="btn btn-lime" href="mailto:eshaandhavala@gmail.com">Email me</a>
        <a class="btn btn-line" href="/resume.pdf">Résumé</a>
        <a class="btn btn-line" href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
        <a class="btn btn-line" href="https://github.com/EshaanDhavala">GitHub</a>
      </p>
    </div>
  </section>
</Game>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: min(calc(100svh - 64px - 140px), 760px); display: flex; flex-direction: column; overflow: hidden; isolation: isolate; }
  .hero-inner { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 2rem; padding: clamp(32px, 6vh, 72px) 0; }
  @media (min-width: 900px) { .hero-inner { grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr); } }
  h1 { display: flex; flex-direction: column; font-weight: 900; font-size: clamp(4rem, 12vw, 10rem); line-height: 0.82; letter-spacing: 0; }
  h1 span { display: block; }
  h1 span:last-child { color: var(--blue); }
  .lede { margin-top: 1.4rem; max-width: 34rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--ink); }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 1.6rem; }
  .proof { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.2rem; }
  .proof li { font-weight: 600; font-size: 0.95rem; padding: 6px 12px; border-radius: 6px; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-2); }
  .proof li:first-child { color: var(--ink); box-shadow: inset 0 0 0 1px var(--blue); }
  .portrait { justify-self: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .ring { position: relative; width: clamp(200px, 26vw, 320px); aspect-ratio: 1; border-radius: 50%; padding: 4px; background: var(--blue); }
  .ring img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 4px solid var(--bg); }
  .portrait figcaption { text-align: center; display: flex; flex-direction: column; gap: 2px; }
  .portrait figcaption b { font: 800 1.7rem/1 var(--display); text-transform: uppercase; }
  .portrait figcaption span { color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 899px) { .portrait { order: -1; } .ring { width: 168px; } .hero-inner { gap: 1.2rem; } }

  .ticker { position: relative; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg); overflow: hidden; }
  .tick-pause { position: absolute; right: 0; top: 0; bottom: 0; width: 48px; border: 0; cursor: pointer; background: linear-gradient(90deg, transparent, var(--bg) 40%); display: grid; place-items: center; }
  .tick-pause span { width: 12px; height: 14px; border-left: 4px solid var(--ink-2); border-right: 4px solid var(--ink-2); }
  .tick-pause[aria-pressed='true'] span { width: 0; height: 0; border-left: 12px solid var(--lime); border-right: 0; border-top: 8px solid transparent; border-bottom: 8px solid transparent; }
  .ticker:has([aria-pressed='true']) .tick { animation-play-state: paused; }
  .tick { display: flex; width: max-content; list-style: none; animation: tick 48s linear infinite; }
  .ticker:hover .tick { animation-play-state: paused; }
  .tick li { display: flex; align-items: baseline; gap: 10px; padding: 12px 28px; white-space: nowrap; color: var(--ink-2); font-weight: 600; font-size: 0.95rem; border-right: 1px solid var(--line); }
  .tick b { color: var(--blue) !important; font: 800 1.2rem/1 var(--display); text-transform: uppercase; color: var(--ink); }
  @keyframes tick { to { transform: translateX(-50%); } }

  /* ---------- projects ---------- */
  .projects { padding-top: clamp(56px, 9vh, 104px); }
  .phead { position: sticky; top: 64px; z-index: 20; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; padding: 14px 0; margin-bottom: 20px; background: var(--bg); }
  .phead h2 { font-size: clamp(2.4rem, 5vw, 3.8rem); }
  .count { color: var(--ink-2); font-weight: 600; margin-top: 4px; }
  .tabs { display: flex; align-items: center; gap: 4px; overflow-x: auto; scrollbar-width: none; max-width: 100%; }
  .tabs button { flex: none; font: 800 1.15rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-2); background: none; border: 0; padding: 12px 14px; cursor: pointer; border-bottom: 3px solid transparent; }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--lime); }
  .hint { display: none; }
  @media (pointer: fine) and (min-width: 900px) { .hint { display: inline-grid; } }
  @media (max-width: 560px) { .phead { top: 58px; } }
  .group { font-size: 1.5rem; color: var(--ink-2); margin: 6px 0 14px; }
  .roster { margin-top: clamp(56px, 9vh, 104px); }
  .hint-txt { color: var(--ink-2); font-size: 0.8rem; margin-left: 2px; }
  .starters { grid-template-columns: minmax(0, 1fr) !important; }
  @media (min-width: 1200px) { .starters { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; } .starters .cell:first-child { grid-column: 1 / -1; } }
  :global(html[data-filtered]) .starters { grid-template-columns: repeat(auto-fill, minmax(min(100%, 272px), 1fr)) !important; }
  :global(html[data-filtered]) .starters .cell { grid-column: auto !important; }
  .grid { display: grid; gap: clamp(12px, 2vw, 22px); grid-template-columns: repeat(auto-fill, minmax(min(100%, 272px), 1fr)); align-items: stretch; }
  .cell { display: flex; min-width: 0; }
  .cell :global(.card) { flex: 1; }
  .cell:has(:global(.card[hidden])) { display: none; }

  /* ---------- spotlight ---------- */
  .spot { margin-top: clamp(72px, 12vh, 140px); display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 1000px) { .spot { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }
  .spot-head { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .spot-head h2 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
  .spot-head p { color: var(--ink-2); font-size: 1.1rem; max-width: 30rem; }
  .spot-panel { --fg-ink: #f3efe6; --fg-accent: var(--lime); --fg-on-ink: #0f1724; background: var(--panel); border-radius: 16px; padding: clamp(20px, 3vw, 32px); box-shadow: inset 0 0 0 1px var(--line); font-family: var(--body); }

  /* ---------- profile ---------- */
  .profile { margin-top: clamp(80px, 14vh, 160px); max-width: 1000px; }
  .p-main { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .p-main h2 { font-size: clamp(2.4rem, 5vw, 3.8rem); }
  .p-main h3 { font-size: 1.6rem; color: var(--blue); margin-top: 22px; }
  .tiles { list-style: none; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .tiles li { background: var(--panel); border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; box-shadow: inset 0 0 0 1px var(--line); }
  .tiles small { color: var(--ink-2); text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.08em; font-weight: 600; }
  .tiles b { font-weight: 600; line-height: 1.3; }
  .career { border-collapse: collapse; width: 100%; }
  .career td { padding: 11px 10px 11px 0; border-bottom: 1px solid var(--line); vertical-align: baseline; }
  .career td:first-child { font: 700 1.1rem/1.2 var(--display); text-transform: uppercase; color: var(--ink-2); white-space: nowrap; width: 9rem; }
  .career td:nth-child(2) { font-weight: 600; }
  .career td:last-child { color: var(--ink-2); }
  @media (max-width: 640px) { .career tr { display: grid; grid-template-columns: 1fr; padding: 10px 0; border-bottom: 1px solid var(--line); } .career td { border: 0; padding: 1px 0; width: auto; } }
  .news { display: flex; flex-direction: column; gap: 4px; text-decoration: none; margin-top: 18px; padding: 12px 0; border-top: 1px solid var(--line); color: var(--ink-2); }
  .news:hover { color: var(--ink); }
  .n-src { color: var(--ink-2); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .news b { color: var(--ink); font-weight: 600; }
  .career tr.minor td { color: var(--ink-2); font-weight: 400; opacity: 0.8; }
  .traits { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .traits li { padding: 7px 13px; border-radius: 8px; background: var(--panel-2); font-weight: 600; font-size: 0.95rem; }
  .contact { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
</style>
