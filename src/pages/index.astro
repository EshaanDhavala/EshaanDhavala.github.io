---
import Space from '../layouts/Space.astro';
import FgLive from '../components/FgLive.astro';
import Ambient from '../components/Ambient.astro';
import Constellation from '../components/space/Constellation.astro';
import Orrery from '../components/space/Orrery.astro';
import LiveStats from '../components/space/LiveStats.astro';
import { entries, CATS } from '../data/entries';
import { tools } from '../data/tools';
import { series } from '../lib/constellations';
import { asset } from '../lib/asset';

const starters = entries.filter((e) => e.starter);
const bench = entries.filter((e) => !e.starter);
const career = [
  ['Summer 2026', 'USAA', 'Data Science Intern'],
  ['2026 – now', 'Bruin Sports Analytics', 'Football co-chair, research analyst'],
  ['2025 – 2026', 'Bruin Sports Analytics', 'Tennis data analyst'],
  ['2024 – 2026', 'Mystic Lake Casino Steakhouse', 'Server assist and lead host'],
  ['2022 – 2023', 'Tokyo Sushi and Grill', 'Host and cashier'],
  ['2020 – 2021', 'Kumon', 'Tutor'],
];
const traits = ['Football', 'UFC', 'Weightlifting', 'Music theory', 'Co-op puzzle games', 'Japanese art history', 'Astronomy', 'Taco Bell'];
const ticker = [
  ['USAA', 'Data Science Intern, summer 2026'],
  ['playbyplay.football', 'live NFL overtime decision engine'],
  ['UCLA Football', 'LLM assistant for the strength staff'],
  ['1,174 clips', 'hand-labeled for PlayScan'],
  ['131 nights', 'of journal entries turned into data'],
  ['26 matches', 'of UCLA Tennis data'],
  ['Bruin Sports Analytics', 'football co-chair'],
];
// my name as a constellation for the sign-off: each letter is a few straight strokes with a star at every corner
const GLYPHS: Record<string, [number, number][][]> = {
  E: [[[56, 0], [0, 0], [0, 100], [56, 100]], [[0, 50], [42, 50]]],
  S: [[[58, 10], [32, 0], [4, 14], [8, 42], [50, 58], [56, 86], [28, 100], [0, 90]]],
  H: [[[0, 0], [0, 100]], [[58, 0], [58, 100]], [[0, 50], [58, 50]]],
  A: [[[0, 100], [30, 0], [60, 100]], [[13, 58], [47, 58]]],
  N: [[[0, 100], [0, 0], [58, 100], [58, 0]]],
  D: [[[0, 0], [0, 100], [36, 96], [58, 70], [58, 30], [36, 4], [0, 0]]],
  V: [[[0, 0], [30, 100], [60, 0]]],
  L: [[[0, 0], [0, 100], [52, 100]]],
};
function nameConstellation(lines: string[], adv = 84, lineH = 150) {
  let sd = 33;
  const rnd = () => ((sd = (sd * 16807) % 2147483647) / 2147483647);
  const widths = lines.map((l) => l.length * adv - (adv - 60));
  const W = Math.max(...widths);
  let d = '';
  const stars: { x: number; y: number; r: number; sx: number; sy: number }[] = [];
  lines.forEach((line, li) => {
    const x0 = (W - widths[li]) / 2, y0 = li * lineH;
    [...line].forEach((ch, ci) => {
      const seen = new Set<string>();
      for (const stroke of GLYPHS[ch]) {
        stroke.forEach(([x, y], k) => {
          const X = x0 + ci * adv + x, Y = y0 + y;
          d += `${k ? 'L' : 'M'}${X},${Y} `;
          const key = `${x},${y}`;
          if (seen.has(key)) return;
          seen.add(key);
          stars.push({ x: X, y: Y, r: 2 + rnd() * 1.6, sx: (rnd() - 0.5) * W * 0.9, sy: (rnd() - 0.5) * 420 });
        });
      }
    });
  });
  // the apex of the last A goes supernova
  const nova = stars.filter((s) => s.y === lineH).reduce((a, b) => (b.x > a.x ? b : a));
  nova.r = 4.4;
  return { d: d.trim(), stars, w: W, h: lineH + 100, nova };
}
const NAME = nameConstellation(['ESHAAN', 'DHAVALA']);
const img = (e: (typeof entries)[number]) => (e.pic.kind === 'img' ? e.pic : null);
---
<Space>
  <!-- 1. Hero: the Herbert play, drawn as stars -->
  <section class="hero" id="top" data-hero data-nebula="violet" data-nebula-x="0.78" data-nebula-y="0.35" aria-labelledby="hero-title">
    <canvas class="hero-play" data-play aria-hidden="true"></canvas>
    <aside class="profile" data-profile aria-label="About me">
      <div class="pf-photo">
        <img src={asset('/img/eshaan-circle.jpg')} alt="Eshaan Dhavala" width="800" height="800" fetchpriority="high" />
        <i class="orbit" aria-hidden="true"><b></b></i>
      </div>
      <dl class="pf-facts">
        <div><dt>Studying</dt><dd>Statistics &amp; Data Science, UCLA</dd></div>
        <div><dt>Graduating</dt><dd>December 2027</dd></div>
        <div><dt>Now</dt><dd>USAA Data Science Intern ’26, football co-chair at Bruin Sports Analytics</dd></div>
        <div><dt>Looking for</dt><dd>2027 roles in data science, ML, analytics</dd></div>
        <div><dt>Into</dt><dd>Football, UFC, weightlifting, astronomy, Taco Bell</dd></div>
      </dl>
    </aside>
    <div class="play-slot" data-play-slot aria-hidden="true"></div>
    <div class="hero-in wrap">
      <h1 id="hero-title" data-hero-name><span>Eshaan</span><span>Dhavala</span></h1>
      <p class="lede">Statistics &amp; Data Science at UCLA, graduating December 2027. I build ML models, LLM tools, and sports analytics.</p>
      <p class="cta">
        <a class="btn btn-white" href="#projects">Browse projects</a>
        <a class="btn btn-ghost" href="/resume.pdf">Résumé</a>
      </p>
      <aside class="telemetry" aria-label="The play behind the name">
        <p class="ro-title">Herbert dropback, 2021 Wk 3 at KC, real 10 Hz tracking data</p>
        <dl>
          <div><dt>After snap</dt><dd><b data-ro-t>0.0</b> s</dd></div>
          <div><dt>Pocket</dt><dd><b data-ro-area>–</b> yd²</dd></div>
          <div><dt>Nearest rusher</dt><dd><b data-ro-rush>–</b> yd</dd></div>
        </dl>
            </aside>
    </div>
  </section>

  <!-- 2. Highlights -->
  <div class="ticker" aria-label="Highlights">
    <ul class="tick">
      {[0, 1].map((k) => ticker.map(([n, s]) => <li aria-hidden={k === 1 ? 'true' : undefined}><b>{n}</b> {s}</li>))}
    </ul>
    <button type="button" class="tick-pause" data-tick-toggle aria-pressed="false" aria-label="Pause highlights"><span></span></button>
  </div>

  <!-- 3. Projects -->
  <section class="projects" id="projects" data-nebula="magenta" data-nebula-x="0.12" data-nebula-y="0.2" aria-labelledby="proj-title">
    <div class="phead wrap">
      <Ambient kind="bars" class="amb amb-bars" />
      <div>
        <h2 id="proj-title">Projects</h2>
        <p class="count">{entries.length} projects. Each constellation is drawn from that project’s data.</p>
      </div>
      <div class="tabs" role="group" aria-label="Filter projects">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {CATS.map((c) => <button type="button" data-filter={c.id} aria-pressed="false">{c.label}</button>)}
      </div>
    </div>

    {starters.map((e, i) => (
      <article class:list={['feature wrap', i % 2 && 'flip']} id={`p-${e.slug}`} data-cats={e.cats.join(' ')} data-feature data-assemble-trigger aria-labelledby={`t-${e.slug}`}>
        <div class="f-sky">
          <Constellation slug={e.slug} class="big-con" assemble="scroll" novaId={`home-${e.slug}`} />
          <p class="con-cap">{series[e.slug]?.from}</p>
        </div>
        <a class="f-card glass-card" href={`/entries/${e.slug}/`} data-tilt>
          <div class="f-media">
            {e.video ? (
              <video src={asset(e.video.clip ?? e.video.src)} poster={asset(e.video.poster)} muted loop playsinline preload="none" data-autoplay aria-label={e.video.label}></video>
            ) : (
              img(e) && <img src={asset(img(e)!.src)} alt={img(e)!.alt} width="1280" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style={`view-transition-name: pic-${e.slug}`} />
            )}
          </div>
          <div class="f-body">
            <h3 id={`t-${e.slug}`}>{e.name}</h3>
            <p class="stat"><span class="num" data-count={e.stat.value}>{e.stat.value}</span><span class="lab">{e.stat.label}</span></p>
            <p class="what">{e.what}</p>
            <ul class="res">{(e.results.length ? e.results : e.built).slice(0, 3).map((r) => <li>{r}</li>)}</ul>
            <p class="meta">{e.where}. {e.stack.join(', ')}.</p>
            <span class="btn btn-white">Open project</span>
          </div>
        </a>
      </article>
    ))}

    <div class="more wrap">
      <Ambient kind="chat" class="amb amb-chat" />
      <h3 class="sub-title" data-group>More projects</h3>
      <ol class="grid">
        {bench.map((e) => (
          <li id={`p-${e.slug}`} data-cats={e.cats.join(' ')} data-rise>
            <a class="card glass-card" href={`/entries/${e.slug}/`} data-tilt>
              <div class="c-media">{img(e) && <img src={asset(img(e)!.src)} alt={img(e)!.alt} width="1280" height="800" loading="lazy" decoding="async" style={`view-transition-name: pic-${e.slug}`} />}</div>
              <div class="c-body">
                <Constellation slug={e.slug} class="mini-con" w={120} h={70} pad={8} starScale={0.6} />
                <h3>{e.name}</h3>
                <p class="stat stat-s"><span class="num" data-count={e.stat.value}>{e.stat.value}</span><span class="lab">{e.stat.label}</span></p>
                <p class="what">{e.what}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. The 3D take -->
  <Orrery />

  <!-- 5. FG model -->
  <section class="spot wrap" id="fg" data-nebula="teal" data-nebula-x="0.85" data-nebula-y="0.5" aria-labelledby="fg-title">
    <Ambient kind="kick" class="amb amb-kick" />
    <Ambient kind="playscan" class="amb amb-playscan" />
    <div class="spot-head" data-rise>
      <h2 id="fg-title">Try the field-goal model</h2>
      <p>Real predictions from my XGBoost model: 8,742 kicks, held-out AUC 0.78. Move the kick.</p>
      <a class="btn btn-ghost" href="/entries/nfl-overtime-4th-down/">See the project</a>
    </div>
    <div class="spot-panel" data-rise><FgLive /></div>
  </section>

  <!-- 6. Tools -->
  <section class="tools wrap" aria-labelledby="tools-title">
    <Ambient kind="closure" class="amb amb-closure" />
    <div class="t-head"><h2 id="tools-title">Tools I built with Claude</h2><a href="/tools/">More on each</a></div>
    <ol class="grid">
      {tools.map((t) => (
        <li data-rise>
          <a class="card glass-card" href={`/tools/#${t.id}`} data-tilt>
            <div class="c-media"><img src={asset(t.img)} alt="" width="1600" height="1000" loading="lazy" /></div>
            <div class="c-body"><h3>{t.name}</h3><p class="what">{t.line}</p></div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- 7. About -->
  <section class="about wrap" id="about" data-nebula="violet" data-nebula-x="0.15" data-nebula-y="0.4" aria-labelledby="about-title">
    <Ambient kind="journal" class="amb amb-journal" />
    <Ambient kind="tennis" class="amb amb-tennis" />
    <Ambient kind="adhd" class="amb amb-adhd" />
    <div class="about-side" data-rise>
      <h2 id="about-title">About me</h2>
      <div class="face-wrap"><img class="face" src={asset('/img/eshaan-circle.jpg')} alt="Eshaan Dhavala" width="800" height="800" loading="lazy" /></div>
    </div>
    <div class="about-body glass-card" data-rise>
      <dl class="facts">
        <div><dt>Studying</dt><dd>Statistics &amp; Data Science, UCLA</dd></div>
        <div><dt>Graduating</dt><dd>December 2027</dd></div>
        <div><dt>Team</dt><dd>Bruin Sports Analytics, football co-chair</dd></div>
        <div><dt>Looking for</dt><dd>2027 roles in data science, ML, analytics</dd></div>
      </dl>
      <h3>Experience</h3>
      <ul class="career">{career.map(([y, t, r], i) => <li class:list={{ minor: i >= 3 }}><span>{y}</span><b>{t}</b><span>{r}</span></li>)}</ul>
      <h3>Interests</h3>
      <p class="traits">{traits.join(', ')}</p>
      <a class="news" href="https://plhswave.org/4411/features/study-hard-crunch-harder/">
        <span>In the news</span>
        My high school paper ran a feature on me and my Taco Bell order: <b>“Study hard, crunch harder”</b> (The Wave, 2024).
      </a>
    </div>
    <LiveStats />
  </section>

  <!-- 8. Sign-off: my name forms as a constellation, then goes supernova -->
  <section class="contact wrap" data-signoff data-nebula="amber" data-nebula-x="0.6" data-nebula-y="0.45" aria-labelledby="contact-title">
    <svg class="con name-con" viewBox={`-12 -12 ${NAME.w + 24} ${NAME.h + 24}`} data-assemble data-mode="enter" data-nova-id="signoff-name" data-nova-x={NAME.nova.x + 12} data-nova-y={NAME.nova.y + 12} data-big data-end="center 60%" aria-hidden="true">
      <path class="con-line" d={NAME.d} pathLength="1" />
      {NAME.stars.map((s) => <circle class="cstar" cx={s.x} cy={s.y} r={s.r.toFixed(2)} data-sx={s.sx.toFixed(1)} data-sy={s.sy.toFixed(1)} />)}
    </svg>
    <h2 id="contact-title">Get in touch</h2>
    <p class="cta">
      <a class="btn btn-white" href="mailto:eshaandhavala@gmail.com">eshaandhavala@gmail.com</a>
      <a class="btn btn-ghost" href="https://www.linkedin.com/in/eDhavala">LinkedIn</a>
      <a class="btn btn-ghost" href="https://github.com/EshaanDhavala">GitHub</a>
      <a class="btn btn-ghost" href="/resume.pdf">Résumé</a>
    </p>
    <p class="k-hint">Press <kbd>⌘K</kbd> or <kbd>/</kbd> to jump anywhere.</p>
    <details class="colophon">
      <summary>What’s moving in the background?</summary>
      <ul>
        <li><b>At the top of the page:</b> a real NFL dropback replayed from 10 Hz tracking data (Herbert, 2021 Week 3 at KC). Bright stars are the offense, dim rings the defense, the outline is the pocket.</li>
        {entries.map((e) => <li><b>{e.name} constellation:</b> {series[e.slug]?.from}.</li>)}
        <li><b>Faint charts:</b> QB clutch ratings, FG make probability, PlayScan’s calls on its demo plays, USAA capture rate, weekly mood, tennis returns, ADHD severity by income, and the AI assistant answering (synthetic demo data).</li>
        <li><b>The 3D system:</b> one planet per project; the featured three are ringed.</li>
        <li><b>Stars, nebulas, shooting stars, supernovas:</b> decoration. Shooting stars come more often when you scroll fast.</li>
      </ul>
    </details>
  </section>

  <Fragment slot="footer" />
</Space>

<script>
  import { gsap, ScrollTrigger, reduce, $, $$, initConstellations, initCountUps, initTilt, initRises, supernova } from '../scripts/cosmos';

  /* ---------- the Herbert play, behind the name ---------- */
  type P = [number, number, string];
  const pc = $<HTMLCanvasElement>('[data-play]')!, px = pc.getContext('2d')!;
  let play: { frames: P[][]; snapIndex: number; releaseIndex: number } | null = null;
  let PW = 0, PH = 0, ft = 0, playOn = true;
  const t0 = performance.now();
  const roT = $('[data-ro-t]')!, roA = $('[data-ro-area]')!, roR = $('[data-ro-rush]')!;
  const hull = (pts: number[][]) => {
    if (pts.length < 3) return pts;
    pts = [...pts].sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    const x = (o: number[], a: number[], b: number[]) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
    const lo: number[][] = [], up: number[][] = [];
    for (const p of pts) { while (lo.length >= 2 && x(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop(); lo.push(p); }
    for (const p of [...pts].reverse()) { while (up.length >= 2 && x(up[up.length - 2], up[up.length - 1], p) <= 0) up.pop(); up.push(p); }
    return lo.slice(0, -1).concat(up.slice(0, -1));
  };
  const area = (r: number[][]) => Math.abs(r.reduce((s, p, i) => { const q = r[(i + 1) % r.length]; return s + p[0] * q[1] - q[0] * p[1]; }, 0)) / 2;
  const at = (f: number) => {
    const F = play!.frames, i = Math.min(F.length - 2, Math.floor(f)), a = f - i;
    return F[i].map((p, k) => { const q = F[i + 1][k] ?? p; return [p[0] + (q[0] - p[0]) * a, p[1] + (q[1] - p[1]) * a, p[2]] as P; });
  };
  // where the play is drawn: on desktop it is fitted into the open space right of my name and above
  // the stats panel, so no player ever sits under the name; on phones it sits above the name
  let cam = { sc: 1, cx: 0, cy: 0 };
  function layoutPlay() {
    if (!play) return;
    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    for (const f of play.frames) for (const [x, y] of f) { minX = Math.min(minX, x); maxX = Math.max(maxX, x); minY = Math.min(minY, y); maxY = Math.max(maxY, y); }
    const pad = 0.8; minX -= pad; maxX += pad; minY -= pad; maxY += pad;
    const box = { l: 0, r: PW, t: 0, b: PH };
    const hero = pc.getBoundingClientRect();
    const textEls = [...$$('[data-hero-name] span'), ...$$('.hero-in > :not(h1)')];
    if (PW >= 900) {
      // measure the text itself, not the block boxes (paragraphs span the full width)
      const rng = document.createRange();
      const textRight = Math.max(...textEls.map((el) => { rng.selectNodeContents(el); return rng.getBoundingClientRect().right; })) - hero.left;
      const prof = $('[data-profile]')!.getBoundingClientRect();
      box.l = Math.min(textRight + 48, prof.left - hero.left); box.r = PW - 40; box.t = prof.bottom - hero.top + 32; box.b = PH - 40;
    } else {
      const slot = $('[data-play-slot]')!.getBoundingClientRect();
      box.l = 8; box.r = PW - 8; box.t = slot.top - hero.top; box.b = slot.bottom - hero.top;
    }
    const sc = Math.min((box.r - box.l) / (maxX - minX), (box.b - box.t) / (maxY - minY));
    cam = { sc, cx: (box.l + box.r) / 2 - ((minX + maxX) / 2) * sc, cy: (box.t + box.b) / 2 - ((minY + maxY) / 2) * sc };
  }
  function sizePlay() {
    const d = Math.min(2, devicePixelRatio || 1);
    PW = pc.offsetWidth; PH = pc.offsetHeight;
    pc.width = PW * d; pc.height = PH * d; px.setTransform(d, 0, 0, d, 0, 0);
    layoutPlay();
    drawPlay();
  }
  function drawPlay() {
    if (!play || !PW) return;
    const { sc, cx, cy } = cam;
    const X = (p: number[]) => cx + p[0] * sc, Y = (p: number[]) => cy + p[1] * sc;
    const pos = at(ft), qb = pos.find((p) => p[2] === 'q')!;
    px.clearRect(0, 0, PW, PH);
    px.lineCap = 'round';
    for (let k = 0; k < pos.length; k++) {
      const kind = pos[k][2]; if (kind === 'b') continue;
      const f0 = Math.max(0, ft - 8);
      px.beginPath();
      for (let f = f0; f <= ft; f += 0.5) { const q = at(f)[k]; f === f0 ? px.moveTo(X(q), Y(q)) : px.lineTo(X(q), Y(q)); }
      px.strokeStyle = kind === 'd' || kind === 'r' ? 'rgba(160,170,190,0.18)' : 'rgba(255,255,255,0.28)'; px.lineWidth = 1; px.stroke();
    }
    let pocket = 0, nd = Infinity;
    if (ft >= play.snapIndex) {
      const ring = hull(pos.filter((p) => p[2] === 'o' || p[2] === 'q').map((p) => [p[0], p[1]]));
      pocket = area(ring);
      px.beginPath(); ring.forEach((p, k) => (k ? px.lineTo(X(p), Y(p)) : px.moveTo(X(p), Y(p)))); px.closePath();
      px.fillStyle = 'rgba(255,255,255,0.04)'; px.fill(); px.strokeStyle = 'rgba(255,255,255,0.55)'; px.lineWidth = 1; px.stroke();
      let near: P | null = null;
      for (const r of pos.filter((p) => p[2] === 'r')) { const d = Math.hypot(r[0] - qb[0], r[1] - qb[1]); if (d < nd) { nd = d; near = r; } }
      if (near) { px.strokeStyle = 'rgba(255,180,92,0.8)'; px.setLineDash([2, 4]); px.beginPath(); px.moveTo(X(qb), Y(qb)); px.lineTo(X(near), Y(near)); px.stroke(); px.setLineDash([]); }
    }
    for (const p of pos) {
      const k = p[2];
      if (k === 'd' || k === 'r') {
        px.beginPath(); px.arc(X(p), Y(p), k === 'r' ? 4 : 3.2, 0, 6.283);
        px.strokeStyle = k === 'r' ? 'rgba(220,226,240,0.75)' : 'rgba(160,170,190,0.45)'; px.lineWidth = 1.2; px.stroke(); continue;
      }
      const r = k === 'q' ? 4.2 : k === 'b' ? 1.8 : 2.8;
      px.shadowColor = '#ffffff'; px.shadowBlur = k === 'q' ? 22 : 12;
      px.fillStyle = k === 'b' ? '#ffcf8a' : '#ffffff'; px.globalAlpha = k === 'w' ? 0.7 : 1;
      px.beginPath(); px.arc(X(p), Y(p), r, 0, 6.283); px.fill();
      px.shadowBlur = 0; px.globalAlpha = 1;
    }
    roT.textContent = Math.max(0, (ft - play.snapIndex) / 10).toFixed(1);
    roA.textContent = pocket ? pocket.toFixed(0) : '–';
    roR.textContent = isFinite(nd) ? nd.toFixed(1) : '–';
  }
  const smooth = (x: number) => x * x * (3 - 2 * x);
  function playLoop() {
    if (!play || !playOn) return;
    // real speed through the throw and the ball's flight, a 0.3 s hold, a 2 s rewind to the snap, a 0.3 s hold
    const end = play.frames.length - 1.001, run = end / 10, holdEnd = 0.3, back = 2, holdStart = 0.3;
    const tt = ((performance.now() - t0) / 1000) % (run + holdEnd + back + holdStart);
    ft = tt < run ? (tt / run) * end : tt < run + holdEnd ? end : tt < run + holdEnd + back ? end * (1 - smooth((tt - run - holdEnd) / back)) : 0;
    drawPlay();
  }
  fetch('/data/hero-play.json').then((r) => r.json()).then((d) => { play = d; document.fonts.ready.then(sizePlay); sizePlay(); if (reduce) { ft = d.releaseIndex; drawPlay(); } });
  new ResizeObserver(sizePlay).observe(pc);
  new IntersectionObserver(([e]) => { playOn = e.isIntersecting; }).observe(pc);
  if (!reduce) gsap.ticker.add(playLoop);

  /* ---------- hero entrance + parallax ---------- */
  if (!reduce) {
    gsap.from('[data-hero-name] span', { y: 12, opacity: 0, duration: 1.1, ease: 'power2.out', stagger: 0.08 });
    gsap.from('.hero-in > :not(h1), [data-profile]', { opacity: 0, duration: 0.9, ease: 'power1.out', delay: 0.35 });
    const st = { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true };
    gsap.to('[data-play]', { yPercent: 22, opacity: 0.35, ease: 'none', scrollTrigger: st });
    gsap.to('.hero-in', { yPercent: -18, ease: 'none', scrollTrigger: st });
    $$('[data-feature]').forEach((f) => {
      gsap.fromTo($('.f-sky', f), { y: 80 }, { y: -80, ease: 'none', scrollTrigger: { trigger: f, start: 'top bottom', end: 'bottom top', scrub: true } });
      gsap.fromTo($('.f-card', f), { y: 50 }, { y: -50, ease: 'none', scrollTrigger: { trigger: f, start: 'top bottom', end: 'bottom top', scrub: true } });
    });
  }
  $('[data-hero-name]')!.addEventListener('click', (e) => supernova(e.clientX, scrollY + e.clientY, true));

  initConstellations();
  initCountUps();
  initTilt();
  initRises();

  /* ---------- ticker + filters ---------- */
  const tt = $('[data-tick-toggle]')!;
  tt.addEventListener('click', () => { const p = tt.getAttribute('aria-pressed') !== 'true'; tt.setAttribute('aria-pressed', String(p)); tt.setAttribute('aria-label', p ? 'Play highlights' : 'Pause highlights'); });
  const items = $$('[data-cats]');
  $$<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter!;
    $$('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((it) => (it.hidden = f !== 'all' && !it.dataset.cats!.split(' ').includes(f)));
    $('[data-group]')!.hidden = !$$('.grid [data-cats]').some((it) => !it.hidden);
    if (!reduce) gsap.fromTo(items.filter((it) => !it.hidden), { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'expo.out', stagger: 0.04 });
    ScrollTrigger.refresh();
  }));
</script>

