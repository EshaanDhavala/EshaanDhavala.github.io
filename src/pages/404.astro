---
import Game from '../layouts/Game.astro';
---
<Game title="Not found">
  <section class="wrap" style="padding: 18vh 0; display: flex; flex-direction: column; gap: 18px; align-items: flex-start;">
    <h1 style="font-size: clamp(3rem, 8vw, 6rem);">Page not found</h1>
    <p style="color: var(--ink-2); font-size: 1.15rem;">That page doesn’t exist.</p>
    <a class="btn btn-lime" href="/">Back to the home page</a>
  </section>
</Game>
