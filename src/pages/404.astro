---
import Space from '../layouts/Space.astro';
---
<Space title="Not found">
  <section class="wrap lost" data-nebula="magenta" data-nebula-x="0.7" data-nebula-y="0.5">
    <h1>Lost in space</h1>
    <p>That page doesn’t exist.</p>
    <a class="btn btn-white" href="/">Back to the home page</a>
  </section>
</Space>

<style>
  .lost { min-height: 80svh; padding-top: 18vh; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  h1 { font-size: clamp(3rem, 9vw, 7rem); font-weight: 300; font-stretch: 125%; letter-spacing: -0.04em; }
  p { color: var(--ink-2); font-size: 1.15rem; }
</style>
