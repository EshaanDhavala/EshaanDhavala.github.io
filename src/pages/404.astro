---
import Kiosk from '../layouts/Kiosk.astro';
---
<Kiosk title="Not found">
  <section style="max-width: 40rem; margin: 0 auto; padding: 6rem 16px; display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
    <h1 style="font-size: clamp(2.4rem, 6vw, 3.6rem); font-stretch: 125%;">Not on the menu.</h1>
    <p style="color: var(--ink-2); font-size: 1.1rem;">That page doesn’t exist.</p>
    <a class="btn btn-sauce" href="/">Back to the menu</a>
  </section>
</Kiosk>
